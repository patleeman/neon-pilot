{
  "schemaVersion": 2,
  "id": "my-crud-page",
  "name": "My Items",
  "description": "Manage a list of items.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js"
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "myItemsList", "handler": "list", "title": "List items" },
      { "id": "myItemsGet", "handler": "get", "title": "Get item" },
      { "id": "myItemsSave", "handler": "save", "title": "Save item" },
      { "id": "myItemsDelete", "handler": "delete", "title": "Delete item" }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "My Items",
        "location": "main",
        "route": "/ext/my-crud-page",
        "component": "CrudPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "nav": [
      {
        "id": "nav",
        "label": "My Items",
        "route": "/ext/my-crud-page",
        "icon": "list"
      }
    ]
  },
  "permissions": []
}
