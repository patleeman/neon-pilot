{
  "schemaVersion": 2,
  "id": "system-template-settings-section",
  "name": "Template: Settings Section",
  "description": "Starter template — contributes a section to the main Settings page. No separate route.",
  "version": "0.1.0",
  "defaultEnabled": false,
  "frontend": {
    "entry": "dist/frontend.js"
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "templateSettingsLoad", "handler": "loadSettings", "title": "Load settings" },
      { "id": "templateSettingsSave", "handler": "saveSettings", "title": "Save settings" }
    ]
  },
  "contributes": {
    "settingsComponent": {
      "id": "template-settings-section",
      "component": "MySettingsSection",
      "sectionId": "settings-template-my-integration",
      "label": "Template: My Integration",
      "description": "One sentence describing this integration.",
      "order": 100
    }
  },
  "permissions": ["settings:read", "settings:write"]
}
