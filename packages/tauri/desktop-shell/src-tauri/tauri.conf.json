{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neon Pilot",
  "version": "0.9.3-rc.3",
  "identifier": "net.neonpilot.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../desktop run build:ui",
    "beforeDevCommand": "pnpm --dir ../../desktop run dev:ui",
    "frontendDist": "../../../desktop/ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neon Pilot",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources"
    ],
    "icon": [
      "../../../desktop/assets/icon.png",
      "../../../desktop/assets/icon.icns"
    ]
  }
}
