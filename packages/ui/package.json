{
  "name": "@neon-pilot/ui",
  "version": "0.11.4",
  "license": "MIT",
  "description": "Neon Pilot shared design-system components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo storybook-static",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "react-dom": "18.3.1",
    "storybook": "8.6.14",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "4.0.18"
  }
}
