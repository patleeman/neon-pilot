{
  "name": "@neon-pilot/desktop",
  "version": "0.11.28",
  "license": "MIT",
  "description": "Neon Pilot Electron desktop shell",
  "repository": "github:patleeman/neon-pilot",
  "bugs": "https://github.com/patleeman/neon-pilot/issues",
  "homepage": "https://neonpilot.net",
  "productName": "Neon Pilot",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build:ui": "cd ui && vite build",
    "build:server": "node scripts/build-server-bundle.mjs",
    "build:deps": "pnpm --dir ../core run build && pnpm run build:ui && pnpm run build:server && node ../../scripts/build-system-extensions.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build": "pnpm run clean && pnpm run build:deps && pnpm run build:main && tsc --build --force",
    "launch": "node scripts/launch-dev-app.mjs",
    "stop": "node scripts/stop-dev-app.mjs",
    "start": "pnpm run stop && pnpm run build && pnpm run launch --",
    "dev": "pnpm --dir ../.. run check:extension-runtime-contracts && pnpm run stop && pnpm run clean && pnpm run build:deps && pnpm run build:main && pnpm run launch --",
    "clean": "rm -rf dist ui/dist server/dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@neon-pilot/core": "workspace:0.11.28",
    "@neon-pilot/extensions": "workspace:0.11.28",
    "@neon-pilot/ui": "workspace:0.11.28",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "electron-updater": "6.8.3",
    "jsdom": "24.1.3",
    "node-pty": "^1.0.0",
    "whisper-cpp-node": "0.2.12"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
