{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neon Pilot Agent Eval Case",
  "type": "object",
  "required": [
    "id",
    "project",
    "lane",
    "time_budget_minutes",
    "repo",
    "base_commit",
    "prompt",
    "allowed_change_scope",
    "validation",
    "scoring",
    "review"
  ],
  "properties": {
    "id": { "type": "string" },
    "project": { "const": "neon-pilot" },
    "source_dataset": { "type": "string" },
    "source_config": { "type": "string" },
    "source_candidate_id": { "type": "string" },
    "case_path": { "type": "string" },
    "lane": { "enum": ["diagnosis", "scoped_fix", "ux_workflow"] },
    "task_type": { "type": "string" },
    "failure_mode": { "type": "string" },
    "time_budget_minutes": { "type": "integer", "minimum": 1 },
    "repo": { "type": "string" },
    "base_commit": { "type": "string", "minLength": 7 },
    "base_commit_subject": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "allowed_change_scope": { "enum": ["none", "repo"] },
    "validation": { "type": "array", "items": { "type": "string" } },
    "scoring": {
      "type": "object",
      "required": ["diff_policy", "require_no_changes", "forbidden_shell_patterns", "judge_rubric", "min_judge_score"],
      "properties": {
        "diff_policy": { "enum": ["no_changes", "focused_changes"] },
        "require_no_changes": { "type": "boolean" },
        "forbidden_tools": { "type": "array", "items": { "type": "string" } },
        "forbidden_shell_patterns": { "type": "array", "items": { "type": "string" } },
        "final_must_include": { "type": "array", "items": { "type": "string" } },
        "judge_rubric": { "type": "string" },
        "min_judge_score": { "type": "number" }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["commit_exists", "commit_strategy", "repo_shape", "feasibility", "notes"],
      "properties": {
        "commit_exists": { "type": "boolean" },
        "commit_strategy": { "enum": ["primary_resolution_commit", "existing_resolution_candidate"] },
        "missing_primary_commit": { "type": "string" },
        "repo_shape": { "type": "array", "items": { "type": "string" } },
        "feasibility": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
