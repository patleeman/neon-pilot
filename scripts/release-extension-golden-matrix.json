{
  "schemaVersion": 1,
  "description": "Release-blocking extension workflows exercised against a packaged desktop app.",
  "requiredExtensions": [
    "system-extension-manager",
    "system-artifacts",
    "system-settings",
    "system-automations",
    "system-conversation-tools",
    "system-diffs",
    "system-routines",
    "system-mcp",
    "system-telemetry",
    "system-todo",
    "system-runs"
  ],
  "appRoutes": [
    {
      "path": "/conversations/new",
      "selectors": ["textarea"]
    },
    {
      "path": "/settings/providers",
      "text": ["Providers"]
    },
    {
      "path": "/settings/desktop",
      "text": ["Desktop"]
    }
  ],
  "registryMinimums": {
    "routes": 6,
    "surfaces": 6,
    "composerShelves": 2,
    "composerControls": 3,
    "composerInputTools": 1,
    "transcriptRenderers": 3,
    "settings": 1
  },
  "routes": [
    {
      "extensionId": "system-extension-manager",
      "path": "/extensions",
      "text": ["Extensions"]
    },
    {
      "extensionId": "system-settings",
      "path": "/settings",
      "text": ["Settings"]
    },
    {
      "extensionId": "system-automations",
      "path": "/automations",
      "text": ["Automations"]
    },
    {
      "extensionId": "system-routines",
      "path": "/routines",
      "text": ["Routines", "How Routines work", "Check before checkpoint"]
    },
    {
      "extensionId": "system-dynamic-workflows",
      "path": "/workflows",
      "text": ["Workflows"]
    },
    {
      "extensionId": "system-telemetry",
      "path": "/telemetry",
      "text": ["Diagnostics"]
    }
  ],
  "actions": [
    {
      "extensionId": "system-extension-manager",
      "actionId": "listExtensions",
      "input": {},
      "text": ["system-extension-manager"]
    },
    {
      "extensionId": "system-extension-manager",
      "actionId": "readSearchPaths",
      "input": {},
      "text": ["defaultLocation"]
    },
    {
      "extensionId": "system-todo",
      "actionId": "getState",
      "input": { "conversationId": "release-golden-smoke" },
      "text": ["items"]
    },
    {
      "extensionId": "system-dynamic-workflows",
      "actionId": "listWorkflows",
      "input": {},
      "text": ["workflows"]
    },
    {
      "extensionId": "system-routines",
      "actionId": "getState",
      "input": {},
      "text": ["hooks", "routines", "checkpoint"]
    }
  ],
  "agentTools": {
    "expectedNames": ["artifact", "bash", "background_bash", "checkpoint", "neon_pilot", "mcp", "scheduled_task", "subagent", "todo"],
    "invocations": [
      {
        "name": "bash",
        "extensionId": "system-runs",
        "actionId": "bash",
        "input": { "command": "printf neon-tool-smoke" },
        "text": ["neon-tool-smoke"]
      },
      {
        "name": "scheduled_task",
        "extensionId": "system-automations",
        "actionId": "scheduledTask",
        "input": { "action": "list" },
        "text": ["tasks"]
      },
      {
        "name": "neon_pilot",
        "extensionId": "system-neon-pilot-admin-cli",
        "actionId": "neonPilotTool",
        "input": { "action": "list_admin_commands" },
        "text": ["list_app_commands"]
      },
      {
        "name": "mcp",
        "extensionId": "system-mcp",
        "actionId": "mcpTool",
        "input": { "action": "list" },
        "text": ["servers"]
      }
    ],
    "contextInvocations": [
      {
        "name": "todo",
        "input": { "action": "add", "text": "Release smoke context todo" },
        "text": ["Added todo"]
      },
      {
        "name": "todo",
        "input": { "action": "list" },
        "text": ["Release smoke context todo"]
      }
    ]
  },
  "installablePackages": [],
  "catalogInstalls": [
    {
      "extensionId": "system-dynamic-workflows"
    }
  ]
}
