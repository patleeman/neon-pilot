{
  "schemaVersion": 2,
  "id": "system-personal-agents",
  "name": "Personal Agents",
  "packageType": "user",
  "defaultEnabled": false,
  "description": "Create durable personal agent profiles with chat-first UI, soul documents, gateway bindings, and profile-scoped context.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listProfiles",
        "handler": "listProfiles",
        "title": "List personal agents",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "getProfile",
        "handler": "getProfile",
        "title": "Get personal agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "createProfile",
        "handler": "createProfile",
        "title": "Create personal agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateProfile",
        "handler": "updateProfile",
        "title": "Update personal agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deleteProfile",
        "handler": "deleteProfile",
        "title": "Delete personal agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "ensureDefaultConversation",
        "handler": "ensureDefaultConversation",
        "title": "Ensure personal agent conversation",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "routeGatewayMessage",
        "handler": "routeGatewayMessage",
        "title": "Route gateway message to a personal agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "provideAgentTurnContext",
        "handler": "provideAgentTurnContext",
        "title": "Personal agent turn context",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSelfProfile",
        "handler": "updateSelfProfile",
        "title": "Update current personal agent profile"
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "update-self-profile",
        "name": "personal_agent_update_self",
        "title": "Update personal agent profile",
        "description": "Update the current personal agent's own profile fields such as name, description, soul document, default cwd, model, memory scopes, skill refs, and tool policy.",
        "action": "updateSelfProfile",
        "promptGuidelines": [
          "Use only when the user asks this personal agent to change its own identity, soul document, runtime defaults, memory scopes, skills, or policy."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "New display name for this personal agent." },
            "description": { "type": "string", "description": "Short description shown in Agent Details." },
            "avatar": { "type": "string", "description": "Short avatar text or emoji." },
            "soul": { "type": "string", "description": "Full replacement soul document for this personal agent." },
            "defaultCwd": { "type": "string", "description": "Default working directory for newly created agent conversations." },
            "defaultModelRef": { "type": "string", "description": "Default model ref, for example provider/model." },
            "defaultRuntimeRef": { "type": "string", "description": "Default runtime identifier." },
            "memoryScopes": { "type": "array", "items": { "type": "string" }, "description": "Replacement memory scope refs." },
            "skillRefs": { "type": "array", "items": { "type": "string" }, "description": "Replacement skill refs." },
            "toolPolicy": { "type": "string", "enum": ["default", "restricted", "custom"], "description": "Tool policy for this personal agent." }
          },
          "additionalProperties": false
        }
      }
    ],
    "nav": [
      {
        "id": "personal-agents",
        "label": "Agents",
        "route": "/agents",
        "icon": "sparkle",
        "sidebarView": "agents-sidebar"
      }
    ],
    "views": [
      {
        "id": "agents",
        "title": "Agent Chat",
        "location": "main",
        "route": "/agents",
        "component": {
          "host": "conversation.page",
          "overrides": {
            "wrapper": "PersonalAgentsShell"
          }
        },
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "agents-sidebar",
        "title": "Agents",
        "location": "sidebar",
        "component": "PersonalAgentsSidebar",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "agent-details",
        "title": "Agent Details",
        "location": "rightRail",
        "component": "PersonalAgentsDetails",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "turnContextProviders": [
      {
        "id": "personal-agent-context",
        "handler": "provideAgentTurnContext",
        "title": "Personal agent context",
        "priority": 35,
        "scope": ["conversation"]
      }
    ]
  },
  "permissions": ["storage:readwrite", "conversations:readwrite"]
}
