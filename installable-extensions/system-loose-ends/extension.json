{
  "schemaVersion": 2,
  "id": "system-loose-ends",
  "name": "Loose Ends",
  "packageType": "system",
  "defaultEnabled": false,
  "description": "Conversation-scoped notes for important context that would otherwise be lost.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "getState", "handler": "getState", "title": "Get Loose Ends" },
      { "id": "setEnabled", "handler": "setEnabled", "title": "Enable Loose Ends" },
      { "id": "addItem", "handler": "addItem", "title": "Add Loose End" },
      { "id": "updateItem", "handler": "updateItem", "title": "Update Loose End" },
      { "id": "deleteItem", "handler": "deleteItem", "title": "Delete Loose End" },
      { "id": "looseEndsTool", "handler": "looseEndsTool", "title": "Loose Ends tool" },
      { "id": "provideTurnContext", "handler": "provideTurnContext", "title": "Loose Ends turn context" }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "loose-ends",
        "title": "Loose Ends",
        "location": "rightRail",
        "scope": "conversation",
        "component": "LooseEndsPanel",
        "icon": "app",
        "activation": "on-open"
      }
    ],
    "tools": [
      {
        "id": "loose-ends",
        "name": "loose_ends",
        "title": "Manage Loose Ends",
        "description": "Manage Loose Ends: concise out-of-band context the user should not lose. Not a work log.",
        "action": "looseEndsTool",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["list", "add", "update"] },
            "id": { "type": "string", "description": "Required for update." },
            "text": { "type": "string", "description": "Required for add, optional for update." },
            "status": { "type": "string", "enum": ["open", "resolved", "dismissed"], "description": "Optional status for update." }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "promptGuidelines": ["Use only for out-of-band context worth preserving later; do not record ordinary work-log details."]
      }
    ],
    "turnContextProviders": [
      {
        "id": "loose-ends",
        "handler": "provideTurnContext",
        "title": "Loose Ends",
        "priority": 60,
        "scope": ["conversation"]
      }
    ]
  },
  "permissions": ["conversations:readwrite"]
}
