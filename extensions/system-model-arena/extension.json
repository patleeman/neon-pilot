{
  "schemaVersion": 2,
  "id": "system-model-arena",
  "name": "Model Arena",
  "packageType": "system",
  "description": "Collect blind model preference duels from normal conversation work.",
  "version": "0.1.0",
  "frontend": { "entry": "dist/frontend.js", "styles": [] },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "getArenaState", "handler": "getArenaState", "title": "Get Model Arena state", "worker": { "enabled": true } },
      { "id": "listArenaModels", "handler": "listArenaModels", "title": "List Model Arena models", "worker": { "enabled": true } },
      { "id": "saveArenaSettings", "handler": "saveArenaSettings", "title": "Save Model Arena settings", "worker": { "enabled": true } },
      { "id": "voteDuel", "handler": "voteDuel", "title": "Vote on Model Arena duel", "worker": { "enabled": true } },
      { "id": "refreshDuel", "handler": "refreshDuel", "title": "Refresh Model Arena duel", "worker": { "enabled": true } },
      { "id": "cancelDuel", "handler": "cancelDuel", "title": "Cancel Model Arena duel", "worker": { "enabled": true } },
      { "id": "startManualDuel", "handler": "startManualDuel", "title": "Start model duel", "worker": { "enabled": true } }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "Model Arena",
        "location": "main",
        "route": "/model-arena",
        "component": "ModelArenaPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "nav": [{ "id": "model-arena-nav", "label": "Model Arena", "route": "/model-arena", "icon": "graph" }],
    "messageActions": [
      {
        "id": "compare-message",
        "title": "Compare models",
        "action": "startManualDuel",
        "when": "role:assistant && hasText",
        "priority": 45
      }
    ],
    "subscriptions": [
      { "id": "prompt-submitted", "source": "conversationPrompt", "pattern": "submitted", "handler": "onPromptSubmitted" },
      {
        "id": "conversation-run-ended",
        "source": "conversation",
        "pattern": "run.ended",
        "handler": "onConversationRunEnded",
        "debounceMs": 100
      }
    ],
    "transcriptBlocks": [{ "id": "model_arena_duel", "component": "ModelArenaDuelBlock", "title": "Model Arena duel", "schemaVersion": 1 }]
  },
  "permissions": ["conversations:readwrite", "storage:readwrite", "models:read"]
}
