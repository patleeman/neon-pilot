{
  "schemaVersion": 2,
  "id": "system-caffeinate",
  "name": "Caffeinate",
  "packageType": "system",
  "defaultEnabled": false,
  "description": "Toggle macOS caffeinate from the top bar to keep the computer awake.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "onDisableAction": "caffeinateStop",
    "actions": [
      { "id": "caffeinateStatus", "handler": "status", "title": "Caffeinate status" },
      { "id": "caffeinateStart", "handler": "start", "title": "Start caffeinate" },
      { "id": "caffeinateStop", "handler": "stop", "title": "Stop caffeinate" },
      { "id": "caffeinateToggle", "handler": "toggle", "title": "Toggle caffeinate" }
    ]
  },
  "contributes": {
    "topBarElements": [
      {
        "id": "caffeinate-toggle",
        "label": "Caffeinate toggle",
        "component": "CaffeinateToggle"
      }
    ]
  },
  "permissions": []
}
