{
  "schemaVersion": 2,
  "id": "system-caffeinate",
  "name": "Caffeinate",
  "packageType": "system",
  "description": "Toggle macOS caffeinate from the top bar to keep the computer awake.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "startupAction": "caffeinateStartup",
    "onDisableAction": "caffeinateStop",
    "actions": [
      { "id": "caffeinateStatus", "handler": "status", "title": "Caffeinate status", "worker": { "enabled": true } },
      { "id": "caffeinateStartup", "handler": "startup", "title": "Caffeinate startup", "worker": { "enabled": true } },
      { "id": "caffeinateStart", "handler": "start", "title": "Start caffeinate", "worker": { "enabled": true } },
      { "id": "caffeinateStop", "handler": "stop", "title": "Stop caffeinate", "worker": { "enabled": true } },
      { "id": "caffeinateToggle", "handler": "toggle", "title": "Toggle caffeinate", "worker": { "enabled": true } }
    ]
  },
  "contributes": {
    "settings": {
      "caffeinate.autoStart": {
        "type": "boolean",
        "default": false,
        "description": "Start macOS caffeinate automatically when Neon Pilot starts.",
        "group": "Caffeinate",
        "order": 1
      }
    },
    "commands": [
      {
        "id": "caffeinate.toggle",
        "title": "Toggle Caffeinate",
        "category": "Caffeinate",
        "action": "caffeinateToggle"
      }
    ],
    "cliCommands": [
      {
        "id": "caffeinate-status",
        "command": "caffeinate status",
        "description": "Read macOS caffeinate status.",
        "action": "caffeinateStatus",
        "jsonDefault": true,
        "usage": "caffeinate status [--json]",
        "examples": ["neon-pilot caffeinate status --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["caffeinate", "status"], "expectJsonFields": [] }
      },
      {
        "id": "caffeinate-start",
        "command": "caffeinate start",
        "description": "Start macOS caffeinate.",
        "action": "caffeinateStart",
        "jsonDefault": true,
        "usage": "caffeinate start [--json]",
        "examples": ["neon-pilot caffeinate start --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "caffeinate-stop",
        "command": "caffeinate stop",
        "description": "Stop macOS caffeinate.",
        "action": "caffeinateStop",
        "jsonDefault": true,
        "usage": "caffeinate stop [--json]",
        "examples": ["neon-pilot caffeinate stop --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "caffeinate-toggle",
        "command": "caffeinate toggle",
        "description": "Toggle macOS caffeinate.",
        "action": "caffeinateToggle",
        "jsonDefault": true,
        "usage": "caffeinate toggle [--json]",
        "examples": ["neon-pilot caffeinate toggle --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ],
    "keybindings": [
      {
        "id": "caffeinate.toggle",
        "title": "Toggle Caffeinate",
        "keys": ["mod+shift+c"],
        "command": "system-caffeinate.caffeinate.toggle",
        "scope": "global"
      }
    ],
    "topBarElements": [
      {
        "id": "caffeinate-toggle",
        "label": "Caffeinate toggle",
        "component": "CaffeinateToggle"
      }
    ]
  },
  "permissions": ["settings:read", "shell:execute"]
}
