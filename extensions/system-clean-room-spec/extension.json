{
  "schemaVersion": 2,
  "id": "system-clean-room-spec",
  "name": "Clean-room Spec Generator",
  "description": "Starts web-only clean-room research conversations that produce implementation briefs for coding agents.",
  "version": "0.1.0",
  "defaultEnabled": false,
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "start", "handler": "start", "title": "Start clean-room spec generator" },
      { "id": "startImplementation", "handler": "startImplementation", "title": "Start implementation from this spec" },
      { "id": "provideTurnContext", "handler": "provideTurnContext", "title": "Clean-room spec instructions" }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "start",
        "title": "Clean-room spec generator",
        "category": "Agent",
        "description": "Start a web-only clean-room research conversation that produces an implementation brief.",
        "action": "start"
      }
    ],
    "turnContextProviders": [
      {
        "id": "clean-room-spec-instructions",
        "handler": "provideTurnContext",
        "title": "Clean-room spec instructions",
        "priority": 100
      }
    ]
  },
  "permissions": ["agent:conversations"]
}
