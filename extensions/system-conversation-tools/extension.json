{
  "schemaVersion": 2,
  "id": "system-conversation-tools",
  "name": "Conversation Tools",
  "packageType": "system",
  "description": "Agent tools for conversation questions, inspection, titles, and working directory changes.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "contributes": {
    "tools": [
      {
        "id": "ask_user",
        "name": "ask_user",
        "title": "Ask User",
        "description": "Ask the user one or more focused questions in the desktop UI.",
        "action": "askUser",
        "promptSnippet": "Ask the user structured questions with buttons, radio choices, or checkboxes.",
        "promptGuidelines": [
          "Ask only when blocked on a real decision or approval. Prefer questions[] for structured choices."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "Legacy single-question form. Use questions[] for multiple questions or check-style questions."
            },
            "details": {
              "type": "string",
              "description": "Optional overall context, or legacy single-question context when question is used alone."
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 6,
              "description": "Legacy quick-reply options for a single-question prompt."
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "Structured questions to render in the desktop UI. Prefer this for multiple questions and radio/check layouts.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Optional stable question id."
                  },
                  "label": {
                    "type": "string",
                    "description": "User-facing question label."
                  },
                  "question": {
                    "type": "string",
                    "description": "Alias for label."
                  },
                  "details": {
                    "type": "string",
                    "description": "Optional supporting context for this question."
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "radio",
                      "check",
                      "checkbox"
                    ],
                    "description": "radio for one choice, check/checkbox for multi-select."
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "description": "Available answers for this question.",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Stable value sent back when selected."
                            },
                            "label": {
                              "type": "string",
                              "description": "User-facing option label. Defaults to value."
                            },
                            "details": {
                              "type": "string",
                              "description": "Optional supporting text shown under the option."
                            }
                          },
                          "required": [
                            "value"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "options"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "transcriptRenderers": [
      {
        "id": "terminal-bash-tool-block",
        "tool": "bash",
        "component": "TerminalBashTranscriptRenderer"
      }
    ],
    "contextMenus": [
      {
        "id": "duplicate-conversation",
        "title": "Duplicate",
        "action": "duplicateConversation",
        "surface": "conversationList"
      },
      {
        "id": "copy-working-directory",
        "title": "Copy Working Directory",
        "action": "copyWorkingDirectory",
        "surface": "conversationList"
      },
      {
        "id": "copy-conversation-id",
        "title": "Copy Session ID",
        "action": "copyConversationId",
        "surface": "conversationList"
      },
      {
        "id": "copy-deeplink",
        "title": "Copy Deeplink",
        "action": "copyDeeplink",
        "surface": "conversationList"
      }
    ],
    "commands": [
      {
        "id": "open-thread-palette",
        "title": "Open thread palette",
        "action": "palette.open",
        "args": {
          "scope": "threads"
        }
      },
      {
        "id": "open-command-palette",
        "title": "Open command palette",
        "action": "palette.open",
        "args": {
          "scope": "commands"
        }
      }
    ],
    "keybindings": [
      {
        "id": "open-thread-palette",
        "title": "Open thread palette",
        "keys": [
          "mod+p"
        ],
        "command": "palette.open",
        "args": {
          "scope": "threads"
        }
      },
      {
        "id": "open-command-palette",
        "title": "Open command palette",
        "keys": [
          "mod+shift+p"
        ],
        "command": "palette.open",
        "args": {
          "scope": "commands"
        }
      }
    ],
    "cliCommands": [
      {
        "id": "conversations-list",
        "command": "conversations list",
        "description": "List conversations, optionally filtered by query.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "inspect"
      },
      {
        "id": "conversations-search",
        "command": "conversations search",
        "description": "Search visible conversation transcript text.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "inspect"
      },
      {
        "id": "conversations-inspect",
        "command": "conversations inspect",
        "description": "Inspect a conversation by id; optional second arg is outline, query, diff, or read_window.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "inspect"
      },
      {
        "id": "conversations-create",
        "command": "conversations create",
        "description": "Create a conversation with an optional title.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "create"
      },
      {
        "id": "conversations-title",
        "command": "conversations title",
        "description": "Set a conversation title: conversations title <id> <title>.",
        "action": "conversationTool",
        "inputAction": "set_title"
      },
      {
        "id": "conversations-cwd",
        "command": "conversations cwd",
        "description": "Change a conversation working directory: conversations cwd <id> <path>.",
        "action": "conversationTool",
        "inputAction": "change_working_directory"
      },
      {
        "id": "conversations-ensure-live",
        "command": "conversations ensure-live",
        "description": "Ensure a conversation has a live runtime: conversations ensure-live <id> [--cwd <path>]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "ensure_live"
      },
      {
        "id": "conversations-send",
        "command": "conversations send",
        "description": "Send a message to a conversation: conversations send <id> --text <message> [--steer]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "send_message"
      },
      {
        "id": "conversations-run-turn",
        "command": "conversations run-turn",
        "description": "Run a conversation turn and wait for completion: conversations run-turn <id> --text <message> [--timeout-ms <ms>]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "run_turn"
      },
      {
        "id": "conversations-abort",
        "command": "conversations abort",
        "description": "Abort a live conversation turn.",
        "action": "conversationTool",
        "inputAction": "abort"
      },
      {
        "id": "conversations-compact",
        "command": "conversations compact",
        "description": "Compact a conversation transcript.",
        "action": "conversationTool",
        "inputAction": "compact"
      },
      {
        "id": "conversations-fork",
        "command": "conversations fork",
        "description": "Fork a conversation: conversations fork <id> [--title <title>] [--target-cwd <path>]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "fork"
      },
      {
        "id": "conversations-tools",
        "command": "conversations tools",
        "description": "Set active tools for a conversation: conversations tools <id> <tool...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "set_active_tools"
      },
      {
        "id": "conversations-rollback",
        "command": "conversations rollback",
        "description": "Rollback recent conversation transcript blocks: conversations rollback <id> [count]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "rollback"
      },
      {
        "id": "conversations-workspace",
        "command": "conversations workspace",
        "description": "Read conversation workspace state.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_get"
      },
      {
        "id": "conversations-workspace-update",
        "command": "conversations workspace update",
        "description": "Update open/sidebar workspace state with --open, --pinned, --archived, --active, --workspace-path, or --remote-controlled.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_update"
      },
      {
        "id": "conversations-open-list",
        "command": "conversations open list",
        "description": "List conversations currently open in the sidebar.",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_get"
      },
      {
        "id": "conversations-open-add",
        "command": "conversations open add",
        "description": "Add conversations to the open/sidebar list: conversations open add <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-open-remove",
        "command": "conversations open remove",
        "description": "Remove conversations from open/sidebar state: conversations open remove <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-open-pin",
        "command": "conversations open pin",
        "description": "Pin conversations in the sidebar: conversations open pin <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-open-unpin",
        "command": "conversations open unpin",
        "description": "Unpin conversations in the sidebar: conversations open unpin <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-open-active",
        "command": "conversations open active",
        "description": "Set or clear the active sidebar conversation: conversations open active [id]",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-archive",
        "command": "conversations archive",
        "description": "Archive conversations by hiding them from normal sidebar/history views: conversations archive <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-unarchive",
        "command": "conversations unarchive",
        "description": "Unarchive conversations: conversations unarchive <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "workspace_open_update"
      },
      {
        "id": "conversations-delete",
        "command": "conversations delete",
        "description": "Permanently delete persisted conversations and remove workspace/sidebar references: conversations delete <id...>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "delete"
      },
      {
        "id": "conversations-retention-prune",
        "command": "conversations retention prune",
        "description": "Prune old persisted conversations: conversations retention prune --older-than 90d --archived-only --dry-run",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "retention_prune"
      },
      {
        "id": "conversations-transcript-append",
        "command": "conversations transcript append",
        "description": "Append a transcript block: conversations transcript append <id> --type <type> --data <json>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "append_transcript_block"
      },
      {
        "id": "conversations-transcript-update",
        "command": "conversations transcript update",
        "description": "Update a transcript block: conversations transcript update <id> <block-id> --type <type> --data <json>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "update_transcript_block"
      },
      {
        "id": "conversations-scratchpad-get",
        "command": "conversations scratchpad get",
        "description": "Get a conversation scratchpad: conversations scratchpad get <id>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "scratchpad"
      },
      {
        "id": "conversations-scratchpad-set",
        "command": "conversations scratchpad set",
        "description": "Replace a conversation scratchpad: conversations scratchpad set <id> --content <markdown>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "scratchpad"
      },
      {
        "id": "conversations-scratchpad-patch",
        "command": "conversations scratchpad patch",
        "description": "Append/prepend to a scratchpad: conversations scratchpad patch <id> --operation append --content <markdown>",
        "action": "conversationTool",
        "jsonDefault": true,
        "inputAction": "scratchpad"
      }
    ]
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "conversationTool",
        "handler": "conversationTool",
        "title": "Conversation",
        "worker": {
          "enabled": true,
          "inputActions": [
            "inspect",
            "create",
            "set_title",
            "change_working_directory",
            "deferred_resume",
            "ensure_live",
            "send_message",
            "run_turn",
            "abort",
            "compact",
            "fork",
            "set_active_tools",
            "workspace_get",
            "workspace_update",
            "workspace_open_update",
            "delete",
            "retention_prune",
            "scratchpad",
            "append_transcript_block",
            "update_transcript_block",
            "rollback"
          ]
        }
      },
      {
        "id": "askUser",
        "handler": "askUser",
        "title": "Ask user",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "conversationInspect",
        "handler": "conversationInspect",
        "title": "Conversation inspect",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "conversationTitle",
        "handler": "conversationTitle",
        "title": "Conversation title",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "conversationCwd",
        "handler": "conversationCwd",
        "title": "Conversation cwd",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deferredResume",
        "handler": "deferredResumeTool",
        "title": "Deferred resume",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "duplicateConversation",
        "handler": "duplicateConversation",
        "title": "Duplicate conversation",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "copyWorkingDirectory",
        "handler": "copyWorkingDirectory",
        "title": "Copy working directory",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "copyConversationId",
        "handler": "copyConversationId",
        "title": "Copy conversation ID",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "copyDeeplink",
        "handler": "copyDeeplink",
        "title": "Copy deeplink",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "permissions": [
    "conversations:readwrite",
    "storage:readwrite",
    "ui:notify"
  ]
}
