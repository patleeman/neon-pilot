{
  "schemaVersion": 2,
  "id": "system-telemetry",
  "name": "Telemetry",
  "packageType": "system",
  "description": "Inspect app traces, model usage, tool health, and runtime performance.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [{ "id": "getTelemetryData", "handler": "getTelemetryData", "title": "Get telemetry data", "worker": { "enabled": true } }],
    "routes": [
      { "method": "GET", "path": "/traces/summary", "handler": "summary", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/model-usage", "handler": "modelUsage", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/cost-by-conversation", "handler": "costByConversation", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tool-health", "handler": "toolHealth", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/context", "handler": "context", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/agent-loop", "handler": "agentLoop", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tokens-daily", "handler": "tokensDaily", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tool-flow", "handler": "toolFlow", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/cache-efficiency", "handler": "cacheEfficiency", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/system-prompt", "handler": "systemPrompt", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/auto-mode", "handler": "autoMode", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/context-pointers", "handler": "contextPointers", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/session-integrity", "handler": "sessionIntegrity", "worker": { "enabled": true } }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "Telemetry",
        "location": "main",
        "route": "/telemetry",
        "component": "TelemetryPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "nav": [
      {
        "id": "telemetry-nav",
        "label": "Telemetry",
        "route": "/telemetry",
        "icon": "graph"
      }
    ]
  },
  "permissions": ["telemetry:read"]
}
