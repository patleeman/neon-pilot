{
  "schemaVersion": 2,
  "id": "system-telemetry",
  "name": "Diagnostics",
  "packageType": "system",
  "description": "Inspect local app activity, model usage, tool health, and performance.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "getTelemetryData", "handler": "getTelemetryData", "title": "Get diagnostics data", "worker": { "enabled": true } },
      {
        "id": "diagnosticsCli",
        "handler": "diagnosticsCli",
        "title": "Diagnostics CLI",
        "worker": {
          "enabled": true
        }
      }
    ],
    "routes": [
      { "method": "GET", "path": "/traces/summary", "handler": "summary", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/model-usage", "handler": "modelUsage", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/cost-by-conversation", "handler": "costByConversation", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tool-health", "handler": "toolHealth", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/context", "handler": "context", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/agent-loop", "handler": "agentLoop", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tokens-daily", "handler": "tokensDaily", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/tool-flow", "handler": "toolFlow", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/cache-efficiency", "handler": "cacheEfficiency", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/system-prompt", "handler": "systemPrompt", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/auto-mode", "handler": "autoMode", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/context-pointers", "handler": "contextPointers", "worker": { "enabled": true } },
      { "method": "GET", "path": "/traces/session-integrity", "handler": "sessionIntegrity", "worker": { "enabled": true } }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "Diagnostics",
        "location": "main",
        "route": "/telemetry",
        "component": "TelemetryPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "nav": [
      {
        "id": "telemetry-nav",
        "label": "Diagnostics",
        "route": "/telemetry",
        "icon": "graph"
      }
    ],
    "cliCommands": [
      {
        "id": "diagnostics",
        "command": "diagnostics",
        "description": "Read Diagnostics data.",
        "action": "diagnosticsCli",
        "jsonDefault": true,
        "usage": "diagnostics [section] [--range <range>] [--json]",
        "examples": [
          "neon-pilot diagnostics summary --json",
          "neon-pilot diagnostics model-usage --range 7d --json",
          "neon-pilot diagnostics all --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "all",
              "summary",
              "model-usage",
              "cost-by-conversation",
              "tool-health",
              "context",
              "agent-loop",
              "tokens-daily",
              "tool-flow",
              "cache-efficiency",
              "system-prompt",
              "auto-mode",
              "context-pointers",
              "session-integrity"
            ]
          },
          "maxItems": 1
        },
        "flagsSchema": {
          "type": "object",
          "properties": { "range": { "type": "string" }, "json": { "type": "boolean" } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["diagnostics", "summary"], "expectJsonFields": [] }
      }
    ]
  },
  "permissions": ["telemetry:read"]
}
