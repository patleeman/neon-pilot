{
  "schemaVersion": 2,
  "id": "system-terminal",
  "name": "Terminal",
  "packageType": "system",
  "description": "Built-in terminal panel with PTY-backed shell integration.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": ["dist/frontend.css"]
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "terminalCreate", "handler": "createTerminal", "title": "Create terminal" },
      { "id": "terminalWrite", "handler": "writeTerminal", "title": "Write to terminal" },
      { "id": "terminalDrain", "handler": "drainTerminal", "title": "Drain terminal output" },
      { "id": "terminalResize", "handler": "resizeTerminal", "title": "Resize terminal" },
      { "id": "terminalClose", "handler": "closeTerminal", "title": "Close terminal" }
    ],
    "routes": [{ "method": "GET", "path": "/stream", "handler": "streamTerminal", "title": "Terminal output stream", "stream": "sse" }]
  },
  "contributes": {
    "views": [
      {
        "id": "terminal-panel",
        "title": "Terminal",
        "location": "rightRail",
        "scope": "workspace",
        "component": "TerminalPanel",
        "icon": "terminal",
        "placement": "workbench-tool",
        "activation": "on-demand",
        "toolSlot": "terminal"
      }
    ]
  },
  "permissions": []
}
