{
  "schemaVersion": 2,
  "id": "system-excalidraw-input",
  "name": "Excalidraw input",
  "packageType": "system",
  "description": "Composer drawing input tool backed by Excalidraw.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "contributes": {
    "keybindings": [
      {
        "id": "excalidraw.createDrawing",
        "title": "Create Drawing",
        "keys": ["mod+shift+x"],
        "command": "composer.createDrawing",
        "when": "composer.canCreateDrawing",
        "scope": "global"
      }
    ],
    "views": [
      {
        "id": "drawings",
        "title": "Drawing",
        "location": "rightRail",
        "scope": "conversation",
        "component": "ExcalidrawWorkbenchPanel",
        "icon": "sparkle",
        "detailView": "drawing-detail",
        "placement": "workbench-tool",
        "activation": "on-open"
      },
      {
        "id": "drawing-detail",
        "title": "Drawing",
        "location": "workbench",
        "scope": "conversation",
        "component": "ExcalidrawWorkbenchDetail",
        "placement": "workbench-tool",
        "activation": "on-open"
      }
    ],
    "composerInputTools": [
      {
        "id": "excalidraw",
        "component": "ExcalidrawInputTool",
        "title": "Create drawing",
        "priority": 100
      }
    ]
  }
}
