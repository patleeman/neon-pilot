    "nav": [
      {
        "id": "extensions-nav",
        "label": "App Manager",
        "route": "/extensions",
        "icon": "sparkle",
        "pageType": "table",
        "section": "settings"
      }
    ],
    "views": [
      {
        "id": "extensions-page",
        "title": "App Manager",
        "location": "main",
        "route": "/extensions",
        "component": "ExtensionManagerPage",
        "activation": "on-route"
      }
