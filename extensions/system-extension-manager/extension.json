            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing app state."
            }
          },
          "additionalProperties": true
        },
        "mode": "destructive",
        "requiresApp": false,
        "destructive": true,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "extensions-catalog",
        "command": "extensions catalog",
        "description": "List installable extension catalog entries.",
        "action": "manageExtension",
        "jsonDefault": true,
        "inputAction": "listInstallable",
        "usage": "extensions catalog [--json]",
