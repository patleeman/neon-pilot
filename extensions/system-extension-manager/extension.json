        "action": "manageExtension",
        "jsonDefault": true,
        "inputAction": "delete",
        "aliases": ["extensions uninstall"],
        "usage": "extensions delete <id> [--json]",
        "examples": ["neon-pilot extensions delete example-id", "neon-pilot extensions delete example-id --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
