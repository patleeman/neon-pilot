    "settingsComponent": {
      "id": "extension-repositories",
      "component": "ExtensionRepositoriesSettingsPanel",
      "sectionId": "settings-extension-repositories",
      "label": "App repositories",
      "description": "Choose where Neon Pilot looks for app packages you can install. Add a GitHub source only when you want packages from another trusted repository.",
