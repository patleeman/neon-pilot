{
  "schemaVersion": 2,
  "id": "system-extension-manager",
  "name": "Extension Manager",
  "packageType": "system",
  "description": "Inspect, install, update, enable, disable, validate, reload, snapshot, and delete extensions.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listExtensions",
        "handler": "listExtensions",
        "title": "List extensions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "createExtension",
        "handler": "createExtension",
        "title": "Create extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "snapshotExtension",
        "handler": "snapshotExtension",
        "title": "Snapshot extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtension",
        "handler": "reloadExtension",
        "title": "Reload extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "smokeExtension",
        "handler": "smokeExtension",
        "title": "Smoke test extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "validateExtension",
        "handler": "validateExtension",
        "title": "Validate extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listInstallableExtensions",
        "handler": "listInstallableExtensions",
        "title": "List installable extensions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installCatalogExtension",
        "handler": "installCatalogExtension",
        "title": "Install catalog extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installExtensionFromUrl",
        "handler": "installExtensionFromUrl",
        "title": "Install extension from URL",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateCatalogExtension",
        "handler": "updateCatalogExtension",
        "title": "Update catalog extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listHostViewComponents",
        "handler": "listHostViewComponents",
        "title": "List host view components",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readSearchPaths",
        "handler": "readSearchPaths",
        "title": "Read extension search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSearchPaths",
        "handler": "updateSearchPaths",
        "title": "Update extension search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readExtensionSources",
        "handler": "readExtensionSources",
        "title": "Read extension catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateExtensionSources",
        "handler": "updateExtensionSources",
        "title": "Update extension catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtensions",
        "handler": "reloadExtensions",
        "title": "Refresh extensions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "provideExtensionAuthoringInstructions",
        "handler": "provideExtensionAuthoringInstructions",
        "title": "Provide extension authoring instructions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "manageExtension",
        "handler": "manageExtension",
        "title": "Manage extension",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list",
            "create",
            "build",
            "snapshot",
            "delete",
            "reload",
            "smoke",
            "invoke",
            "validate",
            "hostViewComponents",
            "listInstallable",
            "installCatalog",
            "updateCatalog",
            "installFromUrl",
            "readSearchPaths",
            "updateSearchPaths",
            "readExtensionSources",
            "updateExtensionSources",
            "reloadExtensions",
            "enable",
            "disable"
          ]
        }
      }
    ]
  },
  "contributes": {
    "instructionProviders": [
      {
        "id": "extension-authoring",
        "handler": "provideExtensionAuthoringInstructions",
        "title": "Extension authoring skill pointer",
        "priority": 40
      }
    ],
    "nav": [
      {
        "id": "extensions-nav",
        "label": "Extensions",
        "route": "/extensions",
        "icon": "sparkle",
        "pageType": "table",
        "section": "settings",
        "applicationId": "system-settings:system",
        "slot": "primary",
        "order": 10,
        "rightSidebarView": "extension-details-rail"
      }
    ],
    "views": [
      {
        "id": "extensions-page",
        "title": "Extensions",
        "location": "main",
        "route": "/extensions",
        "component": "ExtensionManagerPage",
        "applicationId": "system-settings:system",
        "activation": "on-route"
      },
      {
        "id": "extension-details-rail",
        "title": "Extension details",
        "location": "rightRail",
        "route": "/extensions",
        "component": "ExtensionDetailsRail",
        "placement": "primary",
        "scope": "global",
        "activation": "on-open"
      }
    ],
    "settingsComponent": {
      "id": "extension-repositories",
      "component": "ExtensionRepositoriesSettingsPanel",
      "sectionId": "settings-extension-repositories",
      "label": "Extension repositories",
      "description": "Choose where Neon Pilot looks for extensions you can install. Add a GitHub source only when you want extensions from another trusted repository.",
      "order": 20
    },
    "commands": [
      {
        "id": "open",
        "title": "Open Extensions",
        "category": "Extensions",
        "description": "Open the Extension Manager.",
        "action": "app.navigate",
        "args": {
          "to": "/extensions"
        },
        "icon": "sparkle"
      },
      {
        "id": "reload-registry",
        "title": "Reload Extensions",
        "category": "Extensions",
        "description": "Refresh the installed extension list.",
        "action": "reloadExtensions"
      },
      {
        "id": "list-catalog",
        "title": "List Installable Extensions",
        "category": "Extensions",
        "description": "Refresh and list installable extension catalog entries.",
        "action": "listInstallableExtensions"
      },
      {
        "id": "install-catalog",
        "title": "Install Catalog Extension",
        "category": "Extensions",
        "description": "Install an extension from the catalog by id.",
        "action": "installCatalogExtension",
        "argsSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Catalog extension id to install."
            }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      {
        "id": "update-catalog",
        "title": "Update Catalog Extension",
        "category": "Extensions",
        "description": "Update an installed catalog extension by id.",
        "action": "updateCatalogExtension",
        "argsSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Catalog extension id to update."
            }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      }
    ],
    "cliCommands": [
      {
        "id": "extensions-list",
        "command": "extensions list",
        "description": "List installed Neon Pilot extensions.",
        "action": "manageExtension",
        "jsonDefault": true,
        "usage": "extensions list [--json]",
        "examples": ["neon-pilot extensions list", "neon-pilot extensions list --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": {
          "argv": ["extensions", "list"],
          "expectJsonFields": []
        }
      },
      {
        "id": "extensions-create",
        "command": "extensions create",
        "description": "Create an installed extension: extensions create <id> --name <name> [--template <template>]",
        "action": "manageExtension",
        "jsonDefault": true,
        "inputAction": "create",
        "usage": "extensions create <extensionId> --name <name> [--description <text>] [--template <template>] [--json]",
        "examples": [
          "neon-pilot extensions create reading-list --name \"Reading List\" --template page",
          "neon-pilot extensions create local-models --name \"Local Models\" --template application --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: extensionId."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing app state."
            },
            "name": { "type": "string", "description": "User-facing extension name." },
            "description": { "type": "string", "description": "One-sentence user-facing description." },
            "template": {
              "type": "string",
              "enum": [
                "capability",
                "page",
                "application",
                "main-page",
                "route-sidebar",
                "route-right-sidebar",
                "route-shell",
                "right-rail",
                "workbench-detail"
              ],
              "description": "Starter architecture. Prefer capability, page, or application for new work."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "extensions-build",
        "command": "extensions build",
        "description": "Build an installed user extension with Neon Pilot's packaged authoring runtime.",
        "action": "manageExtension",
        "jsonDefault": true,
        "inputAction": "build",
        "usage": "extensions build <extensionId> [--dry-run] [--json]",
        "examples": ["neon-pilot extensions build local-models --dry-run --json"],
        "argsSchema": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: installed extension id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "dry-run": { "type": "boolean", "description": "Validate the request without building the extension." },
            "json": { "type": "boolean", "description": "Print structured JSON output." }
          },
          "additionalProperties": false
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "extensions-snapshot",
        "command": "extensions snapshot",
        "description": "Snapshot an installed extension by id.",
        "action": "manageExtension",
        "jsonDefault": true,
        "inputAction": "snapshot",
        "usage": "extensions snapshot <extensionId> [--json]",
        "examples": ["neon-pilot extensions snapshot system-settings", "neon-pilot extensions snapshot system-settings --json"],
        "argsSchema": {
          "type": "array",
