{
  "schemaVersion": 2,
  "id": "system-extension-manager",
  "name": "Extension Manager",
  "packageType": "system",
  "description": "Inspect, validate, reload, enable, disable, snapshot, import, and export extensions.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listExtensions",
        "handler": "listExtensions",
        "title": "List extensions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "createExtension",
        "handler": "createExtension",
        "title": "Create extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "snapshotExtension",
        "handler": "snapshotExtension",
        "title": "Snapshot extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtension",
        "handler": "reloadExtension",
        "title": "Reload extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "validateExtension",
        "handler": "validateExtension",
        "title": "Validate extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listInstallableExtensions",
        "handler": "listInstallableExtensions",
        "title": "List installable extensions",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installCatalogExtension",
        "handler": "installCatalogExtension",
        "title": "Install catalog extension",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installExtensionFromUrl",
        "handler": "installExtensionFromUrl",
        "title": "Install extension from URL",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installMarketplacePackage",
        "handler": "installMarketplacePackage",
        "title": "Install marketplace package source",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listHostViewComponents",
        "handler": "listHostViewComponents",
        "title": "List host view components",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readSearchPaths",
        "handler": "readSearchPaths",
        "title": "Read extension search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSearchPaths",
        "handler": "updateSearchPaths",
        "title": "Update extension search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readExtensionSources",
        "handler": "readExtensionSources",
        "title": "Read extension catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateExtensionSources",
        "handler": "updateExtensionSources",
        "title": "Update extension catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtensions",
        "handler": "reloadExtensions",
        "title": "Reload extension registry",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "manageExtension",
        "handler": "manageExtension",
        "title": "Manage extension",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list",
            "create",
            "snapshot",
            "reload",
            "validate",
            "hostViewComponents",
            "listInstallable",
            "installCatalog",
            "installFromUrl",
            "installMarketplacePackage",
            "readSearchPaths",
            "updateSearchPaths",
            "readExtensionSources",
            "updateExtensionSources",
            "reloadExtensions"
          ]
        }
      }
    ]
  },
  "contributes": {
    "nav": [{ "id": "extensions-nav", "label": "Extensions", "route": "/extensions", "icon": "sparkle", "section": "settings" }],
    "views": [
      {
        "id": "extensions-page",
        "title": "Extensions",
        "location": "main",
        "route": "/extensions",
        "component": "ExtensionManagerPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "skills": [
      {
        "id": "skills-and-capabilities",
        "title": "Skills and Extension Capabilities",
        "description": "Guidance for distinguishing reusable workflow skills from extension features and imported plugin packages.",
        "path": "skills/skills-and-capabilities/SKILL.md"
      },
      {
        "id": "local-extension-development",
        "title": "Local Extension Development",
        "description": "Workflow for creating, externally building, validating, reloading, and debugging native extensions.",
        "path": "skills/local-extension-development/SKILL.md"
      }
    ]
  },
  "permissions": ["extensions:read", "extensions:write"]
}
