{
  "schemaVersion": 2,
  "id": "system-extension-manager",
  "name": "Extension Manager",
  "packageType": "system",
  "description": "Inspect, validate, reload, enable, disable, snapshot, import, and export extensions.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "listExtensions", "handler": "listExtensions", "title": "List extensions" },
      { "id": "createExtension", "handler": "createExtension", "title": "Create extension" },
      { "id": "snapshotExtension", "handler": "snapshotExtension", "title": "Snapshot extension" },
      { "id": "reloadExtension", "handler": "reloadExtension", "title": "Reload extension" },
      { "id": "validateExtension", "handler": "validateExtension", "title": "Validate extension" },
      { "id": "listInstallableExtensions", "handler": "listInstallableExtensions", "title": "List installable extensions" },
      { "id": "installCatalogExtension", "handler": "installCatalogExtension", "title": "Install catalog extension" },
      { "id": "installExtensionFromUrl", "handler": "installExtensionFromUrl", "title": "Install extension from URL" },
      { "id": "listHostViewComponents", "handler": "listHostViewComponents", "title": "List host view components" },
      { "id": "readSearchPaths", "handler": "readSearchPaths", "title": "Read extension search paths" },
      { "id": "updateSearchPaths", "handler": "updateSearchPaths", "title": "Update extension search paths" },
      { "id": "reloadExtensions", "handler": "reloadExtensions", "title": "Reload extension registry" },
      { "id": "manageExtension", "handler": "manageExtension", "title": "Manage extension" }
    ]
  },
  "contributes": {
    "settingsComponent": {
      "id": "extension-search-paths",
      "component": "ExtensionManagerSettingsPanel",
      "sectionId": "settings-extensions",
      "label": "Installed and available",
      "description": "Install, enable, inspect, and manage extensions.",
      "order": 35
    },
    "nav": [],
    "views": [],
    "skills": [
      {
        "id": "skills-and-capabilities",
        "title": "Skills and Runtime Capabilities",
        "description": "Guidance for distinguishing reusable workflow skills from runtime features and extensions.",
        "path": "skills/skills-and-capabilities/SKILL.md"
      },
      {
        "id": "local-extension-development",
        "title": "Local Extension Development",
        "description": "Workflow for creating, externally building, validating, reloading, and debugging native extensions.",
        "path": "skills/local-extension-development/SKILL.md"
      }
    ]
  },
  "permissions": ["extensions:read", "extensions:write"]
}
