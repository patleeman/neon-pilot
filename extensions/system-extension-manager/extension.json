        "argsSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Catalog app package id to install."
            }
          },
          "required": ["id"],
          "additionalProperties": false
        }
      },
      {
        "id": "update-catalog",
