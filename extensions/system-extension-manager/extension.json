{
  "schemaVersion": 2,
  "id": "system-extension-manager",
  "name": "App Manager",
  "packageType": "system",
  "description": "Inspect, install, update, enable, disable, validate, reload, snapshot, and delete app packages.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listExtensions",
        "handler": "listExtensions",
        "title": "List app packages",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "createExtension",
        "handler": "createExtension",
        "title": "Create app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "snapshotExtension",
        "handler": "snapshotExtension",
        "title": "Snapshot app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtension",
        "handler": "reloadExtension",
        "title": "Reload app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "smokeExtension",
        "handler": "smokeExtension",
        "title": "Smoke test app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "validateExtension",
        "handler": "validateExtension",
        "title": "Validate app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listInstallableExtensions",
        "handler": "listInstallableExtensions",
        "title": "List installable app packages",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installCatalogExtension",
        "handler": "installCatalogExtension",
        "title": "Install catalog app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "installExtensionFromUrl",
        "handler": "installExtensionFromUrl",
        "title": "Install app package from URL",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateCatalogExtension",
        "handler": "updateCatalogExtension",
        "title": "Update catalog app package",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listHostViewComponents",
        "handler": "listHostViewComponents",
        "title": "List host view components",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readSearchPaths",
        "handler": "readSearchPaths",
        "title": "Read app package search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSearchPaths",
        "handler": "updateSearchPaths",
        "title": "Update app package search paths",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readExtensionSources",
        "handler": "readExtensionSources",
        "title": "Read app catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateExtensionSources",
        "handler": "updateExtensionSources",
        "title": "Update app catalog sources",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "reloadExtensions",
        "handler": "reloadExtensions",
        "title": "Refresh app packages",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "manageExtension",
        "handler": "manageExtension",
        "title": "Manage extension",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list",
            "create",
            "snapshot",
            "delete",
            "reload",
            "smoke",
            "validate",
            "hostViewComponents",
            "listInstallable",
            "installCatalog",
            "updateCatalog",
            "installFromUrl",
            "readSearchPaths",
            "updateSearchPaths",
            "readExtensionSources",
            "updateExtensionSources",
            "reloadExtensions",
            "enable",
            "disable"
          ]
        }
      }
    ]
  },
