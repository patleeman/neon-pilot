{
  "schemaVersion": 2,
  "id": "system-mcp",
  "name": "MCP",
  "packageType": "system",
  "description": "Inspect, authenticate, and call configured MCP servers, including servers discovered from active skill-local mcp.json files.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "mcpTool",
        "handler": "mcpTool",
        "title": "MCP tool",
        "worker": {
          "enabled": true,
          "inputActions": ["list", "info", "grep", "call", "auth", "logout"]
        }
      },
      {
        "id": "inspectSettings",
        "handler": "inspectMcpSettings",
        "title": "Inspect MCP settings",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "saveExplicitConfig",
        "handler": "saveExplicitMcpConfig",
        "title": "Save explicit MCP config",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "testServer",
        "handler": "testMcpServer",
        "title": "Test MCP server",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "authServer",
        "handler": "authMcpServer",
        "title": "Authenticate MCP server",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "logoutServer",
        "handler": "logoutMcpServer",
        "title": "Logout MCP server",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "mcpCli",
        "handler": "mcpCli",
        "title": "MCP CLI",
        "worker": {
          "enabled": true,
          "inputActions": ["inspect", "list", "info", "grep", "call", "save", "test", "auth", "logout"]
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "mcp",
        "name": "mcp",
        "title": "MCP",
        "description": "Inspect and call external MCP (Model Context Protocol) servers. Not a Neon Pilot self-admin surface; use the canonical neon_pilot tool for Neon Pilot administration. Supports listing configured servers, inspecting tools, calling tools, searching tools, and managing OAuth authentication.",
        "action": "mcpTool",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "info", "grep", "call", "auth", "logout"],
              "description": "MCP operation to perform."
            },
            "server": { "type": "string", "description": "MCP server name. Required for info, grep, call, auth, logout." },
            "tool": { "type": "string", "description": "Tool name within the server. Used with info and call actions." },
            "pattern": { "type": "string", "description": "Glob pattern to search tools. Used with grep action. Supports * wildcards." },
            "arguments": {
              "type": "string",
              "description": "JSON string of arguments to pass to the tool. Used with call action. Example: '{\"query\":\"hello\"}'"
            },
            "probe": { "type": "boolean", "description": "When listing servers, whether to fetch and display their tools. Default false." }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      }
    ],
    "settingsComponent": {
      "id": "mcp-tools",
      "component": "McpSettingsPanel",
      "sectionId": "settings-capabilities",
      "label": "MCP servers",
      "description": "MCP wrapper config for explicit tool servers, active skill-local mcp.json detection, and runtime tool orchestration.",
      "order": 40
    },
    "cliCommands": [
      {
        "id": "mcp-inspect",
        "command": "mcp inspect",
        "description": "Inspect configured MCP servers and skill-provided MCP manifests.",
        "action": "mcpCli",
        "inputAction": "inspect",
        "jsonDefault": true,
        "usage": "mcp inspect [--json]",
        "examples": ["neon-pilot mcp inspect --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["mcp", "inspect"], "expectJsonFields": [] }
      },
      {
        "id": "mcp-list",
        "command": "mcp list",
        "description": "List MCP servers, optionally probing tools.",
        "action": "mcpCli",
        "inputAction": "list",
        "jsonDefault": true,
        "usage": "mcp list [--probe] [--json]",
        "examples": ["neon-pilot mcp list --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "probe": { "type": "boolean", "description": "Probe servers for tools." }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-info",
        "command": "mcp info",
        "description": "Inspect an MCP server or one server tool.",
        "action": "mcpCli",
        "inputAction": "info",
        "jsonDefault": true,
        "usage": "mcp info <server> [tool] [--json]",
        "examples": ["neon-pilot mcp info github --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-grep",
        "command": "mcp grep",
        "description": "Search tools on an MCP server.",
        "action": "mcpCli",
        "inputAction": "grep",
        "jsonDefault": true,
        "usage": "mcp grep <server> --pattern <glob> [--json]",
        "examples": ["neon-pilot mcp grep github --pattern '*issue*' --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "pattern": { "type": "string", "description": "Tool glob pattern." }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-call",
        "command": "mcp call",
        "description": "Call an MCP tool with JSON arguments.",
        "action": "mcpCli",
        "inputAction": "call",
        "jsonDefault": true,
        "usage": "mcp call <server> <tool> --arguments <json> [--json]",
        "examples": ["neon-pilot mcp call github search_issues --arguments '{\"query\":\"bug\"}' --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "arguments": { "type": "string", "description": "JSON tool arguments." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-test",
        "command": "mcp test",
        "description": "Test an MCP server connection.",
        "action": "mcpCli",
        "inputAction": "test",
        "jsonDefault": true,
        "usage": "mcp test <server> [--json]",
        "examples": ["neon-pilot mcp test github --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-save",
        "command": "mcp save",
        "description": "Save the explicit MCP configuration JSON.",
        "action": "mcpCli",
        "inputAction": "save",
        "jsonDefault": true,
        "usage": "mcp save --config <json> [--json]",
        "examples": ["neon-pilot mcp save --config '{\"mcpServers\":{}}' --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "config": { "type": "string", "description": "MCP configuration JSON." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "required": ["config"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-auth",
        "command": "mcp auth",
        "description": "Authenticate an MCP server.",
        "action": "mcpCli",
        "inputAction": "auth",
        "jsonDefault": true,
        "usage": "mcp auth <server> [--json]",
        "examples": ["neon-pilot mcp auth github --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "mcp-logout",
        "command": "mcp logout",
        "description": "Clear stored OAuth state for an MCP server.",
        "action": "mcpCli",
        "inputAction": "logout",
        "jsonDefault": true,
        "usage": "mcp logout <server> [--json]",
        "examples": ["neon-pilot mcp logout github --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ]
  },
  "permissions": ["mcp:read", "mcp:write"]
}
