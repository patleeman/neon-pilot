            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "bootstrap-provider-save",
        "command": "bootstrap provider save",
        "description": "Create or update a model provider definition.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap provider save [--json]",
        "examples": [
          "neon-pilot bootstrap provider save",
          "neon-pilot bootstrap provider save --json"
        ],
        "argsSchema": {
