              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "bootstrap-provider-model",
        "command": "bootstrap provider model",
        "description": "Create or update a provider model definition.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap provider model [--json]",
        "examples": [
          "neon-pilot bootstrap provider model",
          "neon-pilot bootstrap provider model --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      }
    ],
    "settingsComponent": {
      "id": "neon-pilot-agent",
      "component": "NeonPilotAgentSettingsPanel",
      "sectionId": "neon-pilot-agent-capabilities",
      "label": "Neon Pilot Agent",
      "description": "Enable or disable external Neon Pilot agent CLI entrypoints.",
      "order": 45
