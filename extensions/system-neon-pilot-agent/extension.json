        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap provider set-key [--json]",
        "examples": [
          "neon-pilot bootstrap provider set-key",
          "neon-pilot bootstrap provider set-key --json"
        ],
        "argsSchema": {
