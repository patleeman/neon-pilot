{
  "schemaVersion": 2,
  "id": "system-neon-pilot-agent",
  "name": "Neon Pilot Agent",
  "packageType": "system",
  "defaultEnabled": true,
  "description": "Expose Neon Pilot as a CLI delegated agent runtime. Use neon-pilot for external self-admin and the canonical neon_pilot tool internally.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "neonPilotAgent",
        "handler": "neonPilotAgent",
        "title": "Neon Pilot Agent",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "readSettings",
        "handler": "readSettings",
        "title": "Read Neon Pilot Agent settings",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSettings",
        "handler": "updateSettings",
        "title": "Update Neon Pilot Agent settings",
        "worker": {
          "enabled": true
        }
      }
    ],
    "protocolEntrypoints": [
      {
        "id": "neon-pilot-agent",
        "handler": "neonPilotAgentCli",
        "title": "Neon Pilot Agent CLI",
        "description": "Command-line interface for delegating tasks to Neon Pilot and inspecting durable runs."
      }
    ]
  },
  "contributes": {
    "cliCommands": [
      {
        "id": "bootstrap-doctor",
        "command": "bootstrap doctor",
        "description": "Check whether Neon Pilot is ready for external agent control.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap doctor [--json]",
        "examples": [
          "neon-pilot bootstrap doctor",
          "neon-pilot bootstrap doctor --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ],
        "smoke": {
          "argv": [
            "bootstrap",
            "doctor"
          ],
          "expectJsonFields": []
        }
      },
      {
        "id": "bootstrap-configure",
        "command": "bootstrap configure",
        "description": "Configure Neon Pilot defaults and external-agent entrypoints.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap configure [--json]",
        "examples": [
          "neon-pilot bootstrap configure",
          "neon-pilot bootstrap configure --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "bootstrap-defaults-set",
        "command": "bootstrap defaults set",
        "description": "Set default provider, model, cwd, thinking level, and service tier.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap defaults set [--json]",
        "examples": [
          "neon-pilot bootstrap defaults set",
          "neon-pilot bootstrap defaults set --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
