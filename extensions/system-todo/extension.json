{
  "schemaVersion": 2,
  "id": "system-todo",
  "name": "Todos",
  "packageType": "system",
  "defaultEnabled": true,
  "description": "Conversation-scoped execution todos for agents and users.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "getState",
        "handler": "getState",
        "title": "Get Todos",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "addItem",
        "handler": "addItem",
        "title": "Add Todo",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateItem",
        "handler": "updateItem",
        "title": "Update Todo",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deleteItem",
        "handler": "deleteItem",
        "title": "Delete Todo",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "clearItems",
        "handler": "clearItems",
        "title": "Clear Todos",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "setPlan",
        "handler": "setPlan",
        "title": "Set Todo Plan",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "todoTool",
        "handler": "todoTool",
        "title": "Todo tool",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "provideTurnContext",
        "handler": "provideTurnContext",
        "title": "Todo turn context",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "listTodoConnections",
        "handler": "listTodoConnections",
        "title": "Todo conversation connections",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "todoCli",
        "handler": "todoCli",
        "title": "Todos CLI",
        "worker": {
          "enabled": true,
          "inputActions": ["list", "add", "update", "delete", "clear", "set-plan"]
        }
      }
    ]
  },
  "contributes": {
    "conversationConnectionProviders": [
      {
        "id": "todos",
        "title": "Todos",
        "action": "listTodoConnections",
        "kind": "state",
        "surfaces": ["composerShelf", "cli"],
        "priority": 50
      }
    ],
    "composerShelves": [
      {
        "id": "todos",
        "title": "Todos",
        "component": "TodoShelf",
        "placement": "bottom"
      }
    ],
    "tools": [
      {
        "id": "todo",
        "name": "todo",
        "title": "Manage Todos",
        "description": "Manage the conversation todo list. Use for short-lived execution plans; do not replace the active goal for subtasks.",
        "action": "todoTool",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "add", "update", "delete", "clear", "set", "update_plan"]
            },
            "id": {
              "type": "string",
              "description": "Required for update and delete."
            },
            "text": {
              "type": "string",
              "description": "Required for add; optional for update."
            },
            "status": {
              "type": "string",
              "enum": ["todo", "doing", "done", "blocked", "pending", "in_progress", "completed"],
              "description": "Optional status for add/update. Codex-style aliases are accepted."
            },
            "note": {
              "type": "string",
              "description": "Optional note for add/update/set items."
            },
            "scope": {
              "type": "string",
              "enum": ["done", "all"],
              "description": "Clear only done todos or all todos."
            },
            "items": {
              "type": "array",
              "description": "Required for set. Replaces the full todo list atomically. Each item uses text/status/note.",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["todo", "doing", "done", "blocked", "pending", "in_progress", "completed"]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": ["text", "status"],
                "additionalProperties": false
              }
            },
            "plan": {
              "type": "array",
              "description": "Required for update_plan. Codex-style full checklist replacement using step/status/note.",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "in_progress", "completed", "todo", "doing", "done", "blocked"]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": ["step", "status"],
                "additionalProperties": false
              }
            },
            "explanation": {
              "type": "string",
              "description": "Optional explanation for set/update_plan updates."
            }
          },
          "required": ["action"],
          "additionalProperties": false
        },
        "promptGuidelines": [
          "Use todo for short-lived execution plans and progress tracking within the current conversation.",
          "For multi-step plans or multiple status changes, prefer one atomic full-plan call: action update_plan with plan [{ step, status }], using pending, in_progress, or completed.",
          "Keep at most one in_progress/doing item unless the user explicitly wants parallel work.",
          "Use item-level add/update/delete only for one-off edits; do not make parallel item-level updates to mark multiple todos done.",
          "Do not use todo as a durable project manager, scheduler, or knowledge base.",
          "Do not replace the active goal for temporary subtasks; add or update todos instead."
        ]
      }
    ],
    "cliCommands": [
      {
        "id": "todos-list",
        "command": "todos list",
        "description": "List conversation todos.",
        "action": "todoCli",
        "inputAction": "list",
        "jsonDefault": true,
        "usage": "todos list --conversation-id <conversation-id> [--json]",
        "examples": ["neon-pilot todos list --conversation-id conv_123 --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "conversation-id": { "type": "string" }, "json": { "type": "boolean" } },
          "required": ["conversation-id"],
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["todos", "list", "--conversation-id", "conv_smoke"], "expectJsonFields": [] }
      },
      {
        "id": "todos-add",
        "command": "todos add",
        "description": "Add a conversation todo.",
        "action": "todoCli",
        "inputAction": "add",
        "jsonDefault": true,
        "usage": "todos add --conversation-id <conversation-id> <text> [--status <status>] [--note <note>] [--json]",
        "examples": ["neon-pilot todos add --conversation-id conv_123 \"Run QA\" --status doing --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "conversation-id": { "type": "string" },
            "status": { "type": "string" },
            "note": { "type": "string" },
            "json": { "type": "boolean" },
            "dry-run": { "type": "boolean" }
          },
          "required": ["conversation-id"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "todos-update",
        "command": "todos update",
        "description": "Update a conversation todo.",
        "action": "todoCli",
        "inputAction": "update",
        "jsonDefault": true,
        "usage": "todos update --conversation-id <conversation-id> <todo-id> [--text <text>] [--status <status>] [--note <note>] [--json]",
        "examples": ["neon-pilot todos update --conversation-id conv_123 todo_123 --status done --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "conversation-id": { "type": "string" },
            "text": { "type": "string" },
            "status": { "type": "string" },
            "note": { "type": "string" },
            "json": { "type": "boolean" },
            "dry-run": { "type": "boolean" }
          },
          "required": ["conversation-id"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "todos-delete",
        "command": "todos delete",
        "description": "Delete a conversation todo.",
        "action": "todoCli",
        "inputAction": "delete",
        "jsonDefault": true,
        "usage": "todos delete --conversation-id <conversation-id> <todo-id> [--json]",
        "examples": ["neon-pilot todos delete --conversation-id conv_123 todo_123 --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": { "conversation-id": { "type": "string" }, "json": { "type": "boolean" }, "dry-run": { "type": "boolean" } },
          "required": ["conversation-id"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": true,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "todos-clear",
        "command": "todos clear",
        "description": "Clear done or all conversation todos.",
        "action": "todoCli",
        "inputAction": "clear",
        "jsonDefault": true,
        "usage": "todos clear --conversation-id <conversation-id> [--scope done|all] [--json]",
        "examples": ["neon-pilot todos clear --conversation-id conv_123 --scope done --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "conversation-id": { "type": "string" },
            "scope": { "type": "string", "enum": ["done", "all"] },
            "json": { "type": "boolean" },
            "dry-run": { "type": "boolean" }
          },
          "required": ["conversation-id"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": true,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "todos-set-plan",
        "command": "todos set-plan",
        "description": "Replace a conversation todo plan from JSON.",
        "action": "todoCli",
        "inputAction": "set-plan",
        "jsonDefault": true,
        "usage": "todos set-plan --conversation-id <conversation-id> --plan <json> [--json]",
        "examples": ["neon-pilot todos set-plan --conversation-id conv_123 --plan '[{\"step\":\"Run QA\",\"status\":\"pending\"}]' --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "conversation-id": { "type": "string" },
            "plan": { "type": "string" },
            "json": { "type": "boolean" },
            "dry-run": { "type": "boolean" }
          },
          "required": ["conversation-id", "plan"],
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": true,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ],
    "turnContextProviders": [
      {
        "id": "todos",
        "handler": "provideTurnContext",
        "title": "Todos",
        "priority": 70,
        "scope": ["conversation"]
      }
    ]
  },
  "permissions": ["conversations:readwrite"]
}
