{
  "schemaVersion": 2,
  "id": "system-settings",
  "name": "Settings panels",
  "packageType": "system",
  "description": "Native extension routes for first-party settings panels.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": ["dist/frontend.css"]
  },
  "contributes": {
    "settings": {
      "secrets.provider": {
        "type": "select",
        "default": "keychain",
        "enum": ["keychain", "file", "env-only"],
        "description": "Where secrets are stored. Keychain is recommended on macOS; local file is for development; environment-only mode disables saving.",
        "group": "Security",
        "order": 1
      },
      "conversation.transcriptDisclosure": {
        "type": "select",
        "default": "auto",
        "enum": ["auto", "expanded"],
        "description": "Controls whether tool calls and reasoning details open automatically in the conversation transcript.",
        "group": "Conversation",
        "order": 10
      },
      "conversation.diffDisclosure": {
        "type": "select",
        "default": "collapsed",
        "enum": ["collapsed", "expanded"],
        "description": "Controls whether file changes shown in conversations start collapsed or expanded.",
        "group": "Conversation",
        "order": 11
      },
      "conversation.pinnedToolCalls": {
        "type": "boolean",
        "default": true,
        "description": "Keep important side results, such as edits, checkpoints, artifacts, images, questions, and subagents, visible in the transcript.",
        "group": "Conversation",
        "order": 12
      }
    },
    "nav": [
      {
        "id": "settings-nav",
        "label": "Settings",
        "route": "/settings",
        "icon": "gear",
        "section": "settings",
        "sidebarView": "settings-sidebar"
      }
    ],
    "commands": [
      {
        "id": "open-settings",
        "title": "Open Settings",
        "action": "app.navigate",
        "args": {
          "to": "/settings"
        },
        "icon": "gear"
      }
    ],
    "cliCommands": [
      {
        "id": "settings-list",
        "command": "settings list",
        "description": "List merged Neon Pilot settings, optionally filtered by key prefix.",
        "action": "manageSettings",
        "jsonDefault": true,
        "usage": "settings list [prefix] [--json]",
        "examples": ["neon-pilot settings list", "neon-pilot settings list conversation", "neon-pilot settings list --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "description": "Optional positional args: prefix."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": {
          "argv": ["settings", "list"],
          "expectJsonFields": []
        }
      },
      {
        "id": "settings-schema",
        "command": "settings schema",
        "description": "List settings definitions.",
        "action": "manageSettings",
        "jsonDefault": true,
        "usage": "settings schema [--json]",
        "examples": ["neon-pilot settings schema", "neon-pilot settings schema --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": {
          "argv": ["settings", "schema"],
          "expectJsonFields": []
        }
      },
      {
        "id": "settings-get",
        "command": "settings get",
        "description": "Read a single setting by key.",
        "action": "manageSettings",
        "jsonDefault": true,
        "usage": "settings get <key> [--json]",
        "examples": ["neon-pilot settings get conversation.pinnedToolCalls", "neon-pilot settings get conversation.pinnedToolCalls --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: key."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "settings-set",
        "command": "settings set",
        "description": "Update a non-secret setting by key and JSON value.",
        "action": "manageSettings",
        "inputAction": "set",
        "usage": "settings set <key> <value> [--json]",
        "examples": [
          "neon-pilot settings set conversation.pinnedToolCalls false",
          "neon-pilot settings set conversation.pinnedToolCalls false --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Positional args: key value."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing app state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "settings-reset",
        "command": "settings reset",
        "description": "Reset one or more settings to defaults: settings reset <key...>",
        "action": "manageSettings",
        "jsonDefault": true,
        "inputAction": "reset",
        "usage": "settings reset <key> [--json]",
        "examples": [
          "neon-pilot settings reset conversation.pinnedToolCalls",
          "neon-pilot settings reset conversation.pinnedToolCalls --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: key."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing app state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ],
    "views": [
      {
        "id": "settings",
        "title": "Settings",
        "location": "main",
        "route": "/settings",
        "component": "SettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "providers",
        "title": "Provider settings",
        "location": "main",
        "route": "/settings/providers",
        "component": "ProviderSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "workspace",
        "title": "Workspace settings",
        "location": "main",
        "route": "/settings/workspace",
        "component": "WorkspaceSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "commands",
        "title": "Command settings",
        "location": "main",
        "route": "/settings/commands",
        "component": "CommandsSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "security",
        "title": "Security settings",
        "location": "main",
        "route": "/settings/security",
        "component": "SecuritySettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "extensions",
        "title": "Extension settings",
        "location": "main",
        "route": "/settings/extensions",
        "component": "ExtensionsSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "desktop",
        "title": "Desktop settings",
        "location": "main",
        "route": "/settings/desktop",
        "component": "DesktopSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "settings-sidebar",
        "title": "Settings",
        "location": "sidebar",
        "component": "SettingsSidebar",
        "icon": "gear",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ]
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "manageSettings",
        "handler": "manageSettings",
        "title": "Manage settings",
        "worker": {
          "enabled": true,
          "inputActions": ["list", "schema", "get", "set", "reset"]
        }
      },
      {
        "id": "manageCli",
        "handler": "manageCli",
        "title": "Manage Neon Pilot CLI",
        "worker": {
          "enabled": true,
          "inputActions": ["status", "install", "uninstall"]
        }
      }
    ]
  },
  "permissions": ["settings:read", "settings:write"]
}
