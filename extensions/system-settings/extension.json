{
  "schemaVersion": 2,
  "id": "system-settings",
  "name": "Settings panels",
  "packageType": "system",
  "description": "Native extension routes for first-party settings panels.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "contributes": {
    "settings": {
      "secrets.provider": {
        "type": "select",
        "default": "keychain",
        "enum": ["keychain", "file", "env-only"],
        "description": "Secret storage backend. Keychain is recommended on macOS; file is for dev/headless; env-only disables writes.",
        "group": "Security",
        "order": 1
      },
      "conversation.transcriptDisclosure": {
        "type": "select",
        "default": "auto",
        "enum": ["auto", "expanded"],
        "description": "Conversation transcript details. Auto keeps completed tool and thinking blocks collapsed; Expanded keeps them open.",
        "group": "Conversation",
        "order": 10
      },
      "conversation.diffDisclosure": {
        "type": "select",
        "default": "collapsed",
        "enum": ["collapsed", "expanded"],
        "description": "Inline file diffs in conversations. Collapsed shows a View diff button; Expanded opens file-changing diffs by default.",
        "group": "Conversation",
        "order": 11
      },
      "conversation.pinnedToolCalls": {
        "type": "boolean",
        "default": true,
        "description": "Show important tool calls below collapsed internal-work groups, including edits, checkpoints, artifacts, images, questions, and subagents.",
        "group": "Conversation",
        "order": 12
      }
    },
    "nav": [
      {
        "id": "settings-nav",
        "label": "Settings",
        "route": "/settings",
        "icon": "gear",
        "section": "settings"
      }
    ],
    "commands": [
      {
        "id": "open-settings",
        "title": "Open Settings",
        "action": "app.navigate",
        "args": { "to": "/settings" },
        "icon": "gear"
      }
    ],
    "cliCommands": [
      {
        "id": "settings-list",
        "command": "settings list",
        "description": "List merged Neon Pilot settings, optionally filtered by key prefix.",
        "action": "manageSettings",
        "jsonDefault": true
      },
      {
        "id": "settings-schema",
        "command": "settings schema",
        "description": "List manifest-declared settings schema.",
        "action": "manageSettings",
        "jsonDefault": true
      },
      {
        "id": "settings-get",
        "command": "settings get",
        "description": "Read a single setting by key.",
        "action": "manageSettings",
        "jsonDefault": true
      },
      {
        "id": "settings-set",
        "command": "settings set",
        "description": "Update a manifest-declared non-secret setting by key and JSON value.",
        "action": "manageSettings"
      }
    ],
    "views": [
      {
        "id": "settings",
        "title": "Settings",
        "location": "main",
        "route": "/settings",
        "component": "SettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "providers",
        "title": "Provider settings",
        "location": "main",
        "route": "/settings/providers",
        "component": "ProviderSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "desktop",
        "title": "Desktop settings",
        "location": "main",
        "route": "/settings/desktop",
        "component": "DesktopSettingsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ]
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "manageSettings",
        "handler": "manageSettings",
        "title": "Manage settings",
        "worker": {
          "enabled": true,
          "inputActions": ["list", "schema", "get", "set"]
        }
      }
    ]
  },
  "permissions": ["settings:read", "settings:write"]
}
