{
  "schemaVersion": 2,
  "id": "system-codex-profile",
  "name": "Codex Compatibility",
  "packageType": "system",
  "defaultEnabled": true,
  "description": "Codex-compatible tool profile and apply_patch support for GPT coding models.",
  "version": "0.1.0",
  "backend": {
    "entry": "src/backend.ts",
    "agentExtension": "default",
    "actions": [
      {
        "id": "applyPatch",
        "handler": "applyPatch",
        "title": "Apply Patch",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "image",
        "handler": "image",
        "title": "Image",
        "worker": {
          "enabled": true,
          "ignoreLiveContext": true
        }
      },
      {
        "id": "codexInstructions",
        "handler": "codexInstructions",
        "title": "Codex response instructions",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "modelProfiles": [
      {
        "id": "codex-compatible",
        "title": "Codex Compatible",
        "description": "Codex-compatible behavior for GPT coding models.",
        "match": ["openai-codex/*"],
        "priority": 100
      }
    ],
    "instructionProviders": [
      {
        "id": "codex-response-style",
        "handler": "codexInstructions",
        "title": "Codex response style",
        "priority": 80
      }
    ],
    "tools": [
      {
        "id": "apply-patch",
        "name": "apply_patch",
        "title": "Apply Patch",
        "description": "Apply a Codex-style patch. Supports Add File, Update File, Delete File, and Move to when present in the patch.",
        "action": "applyPatch",
        "when": {
          "providers": ["openai", "openai-codex"]
        },
        "promptSnippet": "Apply Codex-style patches for file changes, including creating new files.",
        "promptGuidelines": ["Use apply_patch for repository file changes."],
        "inputSchema": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "string",
              "description": "Codex-style patch text."
            }
          },
          "required": ["patch"],
          "additionalProperties": false
        }
      },
      {
        "id": "image",
        "name": "image",
        "title": "Generate image",
        "description": "Generate or edit a single image from a prompt, optionally using recent conversation images as references.",
        "action": "image",
        "when": {
          "providers": ["openai", "openai-codex"]
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "quality": {
              "type": "string",
              "enum": ["auto", "low", "medium", "high"]
            },
            "background": {
              "type": "string",
              "enum": ["auto", "opaque", "transparent"]
            },
            "action": {
              "type": "string",
              "enum": ["auto", "generate", "edit"]
            },
            "source": {
              "type": "string",
              "enum": ["none", "latest", "latest-user", "latest-generated", "recent"]
            },
            "sourceCount": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": ["prompt"],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": ["images:read", "images:write"]
}
