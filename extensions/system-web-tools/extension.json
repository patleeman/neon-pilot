{
  "schemaVersion": 2,
  "id": "system-web-tools",
  "name": "Web fetch",
  "packageType": "system",
  "description": "Fetch web content from agent conversations.",
  "version": "0.1.0",
  "backend": {
    "entry": "src/backend.ts",
    "actions": [{ "id": "webFetch", "handler": "webFetch", "title": "Fetch URL" }]
  },
  "contributes": {
    "tools": [
      {
        "id": "web-fetch",
        "name": "web_fetch",
        "title": "Fetch URL",
        "description": "Fetch a URL and extract its readable content as markdown.",
        "action": "webFetch",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "description": "URL to fetch" },
            "raw": { "type": "boolean", "description": "Return raw HTML instead of extracted markdown (default: false)" }
          },
          "required": ["url"],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": ["network:read"]
}
