{
  "schemaVersion": 2,
  "id": "system-code-mode",
  "name": "Code Mode",
  "packageType": "system",
  "defaultEnabled": false,
  "description": "Replace the model-visible tool surface with a JavaScript REPL that exposes tools as globals.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "agentExtension": "default",
    "actions": [
      {
        "id": "readState",
        "handler": "readState",
        "title": "Read Code Mode State"
      },
      {
        "id": "toggleCodeMode",
        "handler": "toggleCodeMode",
        "title": "Toggle Code Mode"
      },
      {
        "id": "consumeDraftState",
        "handler": "consumeDraftState",
        "title": "Consume Draft Code Mode State",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "prepareDraftConversation",
        "handler": "prepareDraftConversation",
        "title": "Prepare Draft Code Mode Conversation",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "applyDraftConversation",
        "handler": "applyDraftConversation",
        "title": "Apply Draft Code Mode Conversation",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "draftConversationCreate": [
      {
        "id": "code-mode-draft-conversation",
        "prepareAction": "prepareDraftConversation",
        "applyAction": "applyDraftConversation"
      }
    ],
    "slashCommands": [
      {
        "name": "code",
        "description": "Toggle code mode for this conversation. Usage: /code, /code on, /code off, /code status",
        "action": "toggleCodeMode"
      }
    ],
    "composerShelves": [
      {
        "id": "code-mode-status",
        "title": "Code Mode",
        "component": "CodeModeShelf",
        "placement": "top"
      }
    ],
    "tools": [
      {
        "id": "exec-code",
        "name": "exec_code",
        "title": "Execute Code",
        "description": "Run JavaScript in the code-mode REPL. Existing tools are available as async functions on tools.<name>(). Use listTools() and describeTool(name) to inspect available tool APIs.",
        "nativeRegistration": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "JavaScript code to run. Use await with tools.<name>(input). Return a concise final value when useful."
            },
            "timeoutMs": {
              "type": "number",
              "minimum": 1000,
              "maximum": 120000,
              "description": "Optional execution timeout in milliseconds."
            }
          },
          "required": ["code"],
          "additionalProperties": false
        },
        "promptGuidelines": [
          "Code mode exposes only exec_code to the model; call listTools() or describeTool(name) inside exec_code to discover tool APIs.",
          "Use await tools.<name>(input) to call existing tools from JavaScript. Do not invent globals; inspect the catalog when unsure.",
          "Keep code-mode snippets focused and return concise structured results."
        ]
      }
    ]
  }
}
