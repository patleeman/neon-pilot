{
  "schemaVersion": 2,
  "id": "system-computer-use",
  "name": "Computer Use",
  "packageType": "system",
  "description": "Drive native desktop apps through Cua Driver in the background.",
  "version": "0.1.0",
  "permissions": ["ui:notify"],
  "backend": {
    "entry": "dist/backend.mjs",
    "startupAction": "computerUseStartup",
    "actions": [
      {
        "id": "computerUse",
        "handler": "computerUse",
        "title": "Computer use",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "computerUseStatus",
        "handler": "computerUseStatus",
        "title": "Computer Use status",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "computerUseDoctor",
        "handler": "computerUseDoctor",
        "title": "Run Computer Use doctor",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "computerUseInstall",
        "handler": "computerUseInstall",
        "title": "Install Cua Driver",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "computerUseSetupStatus",
        "handler": "computerUseSetupStatus",
        "title": "Computer Use setup status",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "computerUseStartup",
        "handler": "computerUseStartup",
        "title": "Computer Use startup check",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "computer-use.status",
        "title": "Check Computer Use status",
        "category": "Computer Use",
        "action": "computerUseStatus"
      },
      {
        "id": "computer-use.doctor",
        "title": "Run Computer Use doctor",
        "category": "Computer Use",
        "action": "computerUseDoctor"
      },
      {
        "id": "computer-use.install",
        "title": "Install Cua Driver",
        "category": "Computer Use",
        "action": "computerUseInstall"
      }
    ],
    "setupItems": [
      {
        "id": "cua-driver",
        "title": "Install Cua Driver for Computer Use",
        "description": "Installs and checks the local Cua Driver runtime used to capture and control native desktop apps.",
        "capability": "Computer Use",
        "severity": "recommended",
        "statusAction": "computerUseSetupStatus",
        "actions": [
          {
            "id": "install",
            "label": "Install",
            "action": "computerUseInstall",
            "tone": "primary"
          },
          {
            "id": "doctor",
            "label": "Run Doctor",
            "action": "computerUseDoctor",
            "tone": "default"
          }
        ],
        "dismissible": true,
        "order": 30
      }
    ],
    "cliCommands": [
      {
        "id": "computer-use-status",
        "command": "computer-use status",
        "description": "Read Computer Use driver status.",
        "action": "computerUseStatus",
        "jsonDefault": true,
        "usage": "computer-use status [--json]",
        "examples": ["neon-pilot computer-use status --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["computer-use", "status"], "expectJsonFields": [] }
      },
      {
        "id": "computer-use-doctor",
        "command": "computer-use doctor",
        "description": "Run Computer Use diagnostics.",
        "action": "computerUseDoctor",
        "jsonDefault": true,
        "usage": "computer-use doctor [--json]",
        "examples": ["neon-pilot computer-use doctor --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "computer-use-install",
        "command": "computer-use install",
        "description": "Install Cua Driver for Computer Use.",
        "action": "computerUseInstall",
        "jsonDefault": true,
        "usage": "computer-use install [--json]",
        "examples": ["neon-pilot computer-use install --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ],
    "tools": [
      {
        "id": "computer-use",
        "name": "computer_use",
        "title": "Computer Use",
        "description": "Capture and control visible native desktop apps through Cua Driver without moving the real cursor or stealing focus.",
        "action": "computerUse",
        "promptGuidelines": [
          "Use for native desktop apps; prefer browser tools for web-only tasks, recapture after state changes, and never type passwords or click permission dialogs."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["status", "doctor", "capture", "window_state", "click", "type", "key", "scroll", "drag", "focus_app"]
            },
            "arguments": {
              "type": "object",
              "description": "Raw or additional Cua MCP arguments.",
              "additionalProperties": true
            },
            "pid": {
              "type": "number"
            },
            "window_id": {
              "type": "number"
            },
            "element": {
              "type": "number"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "keys": {
              "type": "string"
            },
            "button": {
              "type": "string"
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      }
    ],
    "skills": [
      {
        "id": "computer-use",
        "title": "Computer Use",
        "description": "Use when controlling native desktop apps through Cua Driver.",
        "path": "skills/computer-use/SKILL.md"
      }
    ]
  },
  "permissions": ["shell:execute", "mcp:read", "mcp:write"]
}
