{
  "schemaVersion": 2,
  "id": "system-neon-pilot-admin-cli",
  "name": "Neon Pilot Admin CLI",
  "packageType": "system",
  "description": "Unified Neon Pilot administration guidance for the first-class CLI control plane.",
  "version": "0.1.0",
  "defaultEnabled": true,
  "contributes": {
    "tools": [
      {
        "id": "neon-pilot-admin",
        "name": "neon_pilot",
        "title": "Neon Pilot",
        "description": "Canonical internal Neon Pilot self-admin tool. Use this instead of standalone self-admin tools or MCP. Commands: list_admin_commands, list_app_commands, run_app_command, control_plane_doctor, heartbeat_start, heartbeat_list, heartbeat_stop.",
        "action": "neonPilotTool",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "enum": [
                "list_admin_commands",
                "list_app_commands",
                "run_app_command",
                "control_plane_doctor",
                "heartbeat_start",
                "heartbeat_list",
                "heartbeat_stop"
              ],
              "description": "Admin command to run. Defaults to list_admin_commands."
            },
            "commandId": {
              "type": "string",
              "description": "App command id for run_app_command."
            },
            "args": {
              "description": "Arguments for run_app_command."
            },
            "heartbeatId": {
              "type": "string",
              "description": "Heartbeat id for heartbeat_start/heartbeat_stop."
            },
            "intervalMinutes": {
              "type": "number",
              "minimum": 1,
              "maximum": 59,
              "description": "Heartbeat interval in minutes."
            },
            "conversationId": {
              "type": "string",
              "description": "Conversation id for heartbeat_start."
            },
            "prompt": {
              "type": "string",
              "description": "Prompt to send on each heartbeat."
            }
          },
          "additionalProperties": true
        }
      }
    ],
    "cliCommands": [
      {
        "id": "app-commands-list",
        "command": "app-commands list",
        "description": "List command-palette/app commands available to extensions.",
        "action": "manageAppCommands",
        "jsonDefault": true,
        "inputAction": "list"
      },
      {
        "id": "app-commands-run",
        "command": "app-commands run",
        "description": "Run a command-palette/app command by id: app-commands run <command-id> [--args <json>]",
        "action": "manageAppCommands",
        "jsonDefault": true,
        "inputAction": "run"
      },
      {
        "id": "control-plane-doctor",
        "command": "control-plane doctor",
        "description": "Run control-plane smoke checks for commands, conversations, retention dry-run, runtime, and extension storage.",
        "action": "controlPlaneDoctor",
        "jsonDefault": true,
        "inputAction": "doctor"
      },
      {
        "id": "heartbeats-start",
        "command": "heartbeats start",
        "description": "Start a recurring conversation heartbeat: heartbeats start <id> --interval-minutes <n> --conversation-id <id> --prompt <prompt>.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_start"
      },
      {
        "id": "heartbeats-list",
        "command": "heartbeats list",
        "description": "List recurring conversation heartbeats.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_list"
      },
      {
        "id": "heartbeats-stop",
        "command": "heartbeats stop",
        "description": "Stop a recurring conversation heartbeat: heartbeats stop <id>.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_stop"
      }
    ],
    "skills": [
      {
        "id": "neon-pilot-admin-cli",
        "title": "Neon Pilot Admin CLI",
        "description": "Use the Neon Pilot Admin CLI for self-administration of conversations, workspace/sidebar state, runs, automations, extensions, settings, and extension-contributed surfaces.",
        "path": "skills/neon-pilot-admin-cli/SKILL.md"
      }
    ]
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "neonPilotAdmin",
        "handler": "neonPilotAdmin",
        "title": "Neon Pilot Admin",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list_admin_commands",
            "list_app_commands",
            "run_app_command",
            "control_plane_doctor",
            "heartbeat_start",
            "heartbeat_list",
            "heartbeat_stop"
          ]
        }
      },
      {
        "id": "manageAppCommands",
        "handler": "manageAppCommands",
        "title": "App Commands",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list",
            "run"
          ]
        }
      },
      {
        "id": "controlPlaneDoctor",
        "handler": "controlPlaneDoctor",
        "title": "Control Plane Doctor",
        "worker": {
          "enabled": true,
          "inputActions": [
            "doctor"
          ]
        }
      },
      {
        "id": "neonPilotTool",
        "handler": "neonPilotTool",
        "title": "Neon Pilot Admin Tool",
        "worker": {
          "enabled": true,
          "inputActions": [
            "list_admin_commands",
            "list_app_commands",
            "run_app_command",
            "control_plane_doctor",
            "heartbeat_start",
            "heartbeat_list",
            "heartbeat_stop"
          ]
        }
      }
    ]
  }
}
