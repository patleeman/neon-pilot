        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": {
          "argv": ["heartbeats", "list"],
          "expectJsonFields": []
        }
      },
      {
        "id": "heartbeats-stop",
        "command": "heartbeats stop",
        "description": "Stop a recurring conversation heartbeat: heartbeats stop <id>.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_stop",
        "usage": "heartbeats stop <id> [--json]",
        "examples": ["neon-pilot heartbeats stop example-id", "neon-pilot heartbeats stop example-id --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "bootstrap-doctor",
        "command": "bootstrap doctor",
        "description": "Check whether Neon Pilot is ready for external agent control.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap doctor [--json]",
        "examples": ["neon-pilot bootstrap doctor", "neon-pilot bootstrap doctor --json"],
        "argsSchema": {
          "type": "array",
