        "description": "Store a provider API key through the configured secrets backend. Use --stdin.",
        "action": "neonPilotAgent",
        "jsonDefault": true,
        "usage": "bootstrap provider set-key <provider> --stdin [--json]",
        "examples": ["neon-pilot bootstrap provider set-key openai --stdin", "neon-pilot bootstrap provider set-key openai --stdin --json"],
