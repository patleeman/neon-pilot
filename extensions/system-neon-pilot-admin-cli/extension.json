{
  "schemaVersion": 2,
  "id": "system-neon-pilot-admin-cli",
  "name": "Neon Pilot CLI",
  "packageType": "system",
  "description": "Unified Neon Pilot CLI control plane for internal agents and external callers.",
  "version": "0.1.0",
  "defaultEnabled": true,
  "contributes": {
    "tools": [
      {
        "id": "neon-pilot-admin",
        "name": "neon_pilot",
        "title": "Neon Pilot CLI",
        "description": "Canonical internal Neon Pilot CLI/control-plane tool. Use this instead of standalone self-admin tools or MCP. Commands cover app commands, control-plane doctor, heartbeats, bootstrap, delegated tasks, conversations, and durable runs.",
        "action": "neonPilotTool",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "enum": [
                "list_admin_commands",
                "list_app_commands",
                "run_app_command",
                "app_update",
                "control_plane_doctor",
                "heartbeat_start",
                "heartbeat_list",
                "heartbeat_stop",
                "bootstrap_doctor",
                "bootstrap_configure",
                "bootstrap_defaults_set",
                "bootstrap_provider_set_key",
                "bootstrap_provider_save",
                "bootstrap_provider_model",
                "run_task",
                "conversation_create",
                "conversation_send",
                "conversation_get",
                "conversation_list",
                "conversation_abort",
                "conversation_close",
                "subagent_start",
                "subagent_follow_up",
                "runs_list",
                "runs_get",
                "runs_logs",
                "runs_cancel",
                "runs_rerun",
                "capabilities"
              ],
              "description": "Admin command to run. Defaults to list_admin_commands."
            },
            "commandId": {
              "type": "string",
              "description": "App command id for run_app_command."
            },
            "args": {
              "description": "Arguments for run_app_command."
            },
            "heartbeatId": {
              "type": "string",
              "description": "Heartbeat id for heartbeat_start/heartbeat_stop."
            },
            "intervalMinutes": {
              "type": "number",
              "minimum": 1,
              "maximum": 59,
              "description": "Heartbeat interval in minutes."
            },
            "conversationId": {
              "type": "string",
              "description": "Conversation id for heartbeat_start."
            },
            "prompt": {
              "type": "string",
              "description": "Prompt to send on each heartbeat."
            },
            "channel": {
              "type": "string",
              "enum": ["stable", "rc"],
              "description": "Release channel for app_update."
            },
            "appDir": {
              "type": "string",
              "description": "Destination Applications directory for app_update."
            },
            "repo": {
              "type": "string",
              "description": "GitHub owner/name release repo for app_update."
            }
          },
          "additionalProperties": true
        }
      }
    ],
    "cliCommands": [
      {
        "id": "app-update",
        "command": "app update",
        "description": "Update the packaged Neon Pilot app from the signed GitHub release installer.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "app_update",
        "usage": "app update [--channel stable|rc] [--app-dir /Applications] [--repo owner/name] [--dry-run] [--json]",
        "examples": ["neon-pilot app update --json", "neon-pilot app update --channel rc --json", "neon-pilot app update --dry-run --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Show the installer command without changing the app."
            },
            "channel": {
              "type": "string",
              "enum": ["stable", "rc"],
              "description": "Release channel to install."
            },
            "app-dir": {
              "type": "string",
              "description": "Destination Applications directory."
            },
            "repo": {
              "type": "string",
              "description": "GitHub owner/name release repo."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "app-commands-list",
        "command": "app-commands list",
        "description": "List command-palette/app commands available to extensions. Advanced escape hatch; prefer first-class CLI commands when available.",
        "action": "manageAppCommands",
        "jsonDefault": true,
        "inputAction": "list",
        "usage": "app-commands list [--json]",
        "examples": ["neon-pilot app-commands list", "neon-pilot app-commands list --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "app-commands-run",
        "command": "app-commands run",
        "description": "Run a command-palette/app command by id. Advanced escape hatch; prefer first-class CLI commands when available.",
        "action": "manageAppCommands",
        "jsonDefault": true,
        "inputAction": "run",
        "usage": "app-commands run <commandId> [args...] [--args <json>] [--json]",
        "examples": ["neon-pilot app-commands run cmd-1", "neon-pilot app-commands run cmd-1 --args '{\"value\":1}' --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: commandId and optional command arguments."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            },
            "args": {
              "type": "string",
              "description": "JSON arguments to pass to the app command."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "control-plane-doctor",
        "command": "control-plane doctor",
        "description": "Run control-plane smoke checks for commands, conversations, retention dry-run, runtime, and extension storage.",
        "action": "controlPlaneDoctor",
        "jsonDefault": true,
        "inputAction": "doctor",
        "usage": "control-plane doctor [--json]",
        "examples": ["neon-pilot control-plane doctor", "neon-pilot control-plane doctor --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": {
          "argv": ["control-plane", "doctor"],
          "expectJsonFields": []
        }
      },
      {
        "id": "heartbeats-start",
        "command": "heartbeats start",
        "description": "Start a recurring conversation heartbeat: heartbeats start <id> --interval-minutes <n> --conversation-id <id> --prompt <prompt>.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_start",
        "usage": "heartbeats start <id> --interval-minutes <n> --conversation-id <id> --prompt <prompt> [--json]",
        "examples": [
          "neon-pilot heartbeats start hb-1 --interval-minutes 5 --conversation-id conv-1 --prompt \"Check work.\"",
          "neon-pilot heartbeats start hb-1 --interval-minutes 5 --conversation-id conv-1 --prompt \"Check work.\" --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            },
            "interval-minutes": {
              "type": "string",
              "minLength": 1,
              "description": "Heartbeat interval in minutes, from 1 to 59."
            },
            "conversation-id": {
              "type": "string",
              "minLength": 1,
              "description": "Conversation that receives the heartbeat."
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "Prompt to send on each heartbeat."
            }
          },
          "required": ["interval-minutes", "conversation-id", "prompt"],
          "additionalProperties": true
        },
        "mode": "background",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "heartbeats-list",
        "command": "heartbeats list",
        "description": "List recurring conversation heartbeats.",
        "action": "neonPilotAdmin",
        "jsonDefault": true,
        "inputAction": "heartbeat_list",
        "usage": "heartbeats list [--json]",
        "examples": ["neon-pilot heartbeats list", "neon-pilot heartbeats list --json"],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
