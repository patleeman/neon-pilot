{
  "schemaVersion": 2,
  "id": "system-skills",
  "name": "Skills",
  "packageType": "system",
  "description": "Compatibility actions for agent skills. Manage visible skill settings in Prompt Assembly.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listSkills",
        "handler": "listSkills",
        "title": "List skills",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSkillEnabled",
        "handler": "updateSkillEnabled",
        "title": "Enable or disable a skill",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {},
  "permissions": ["extensions:read", "mcp:write"]
}
