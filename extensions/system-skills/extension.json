{
  "schemaVersion": 2,
  "id": "system-skills",
  "name": "Skills",
  "packageType": "system",
  "description": "Compatibility actions for agent skills. Manage visible skill settings in Prompt Assembly.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listSkills",
        "handler": "listSkills",
        "title": "List skills",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateSkillEnabled",
        "handler": "updateSkillEnabled",
        "title": "Enable or disable a skill",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "skillsCli",
        "handler": "skillsCli",
        "title": "Skills CLI",
        "worker": {
          "enabled": true,
          "inputActions": ["list", "enable", "disable"]
        }
      }
    ]
  },
  "contributes": {
    "nav": [
      {
        "id": "skills-nav",
        "label": "Skills",
        "route": "/skills",
        "icon": "sparkle",
        "pageType": "table",
        "section": "settings",
        "rightSidebarView": "skills-context-rail"
      }
    ],
    "views": [
      {
        "id": "skills-page",
        "title": "Skills",
        "location": "main",
        "route": "/skills",
        "component": "SkillsPage",
        "activation": "on-route"
      },
      {
        "id": "skills-context-rail",
        "title": "Skill details",
        "location": "rightRail",
        "route": "/skills",
        "component": "SkillsContextRail",
        "placement": "primary",
        "scope": "global",
        "activation": "on-open"
      }
    ],
    "commands": [
      {
        "id": "skills.open",
        "title": "Open Skills",
        "category": "Skills",
        "description": "Open the Skills marketplace and installed skill manager.",
        "action": "app.navigate",
        "args": { "to": "/skills" },
        "icon": "sparkle"
      }
    ],
    "cliCommands": [
      {
        "id": "skills-list",
        "command": "skills list",
        "description": "List skills available to agents.",
        "action": "skillsCli",
        "inputAction": "list",
        "jsonDefault": true,
        "usage": "skills list [--json]",
        "examples": ["neon-pilot skills list --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["skills", "list"], "expectJsonFields": [] }
      },
      {
        "id": "skills-enable",
        "command": "skills enable",
        "description": "Enable a skill by id.",
        "action": "skillsCli",
        "inputAction": "enable",
        "jsonDefault": true,
        "usage": "skills enable <skill-id> [--json]",
        "examples": ["neon-pilot skills enable code-review --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "skills-disable",
        "command": "skills disable",
        "description": "Disable a skill by id.",
        "action": "skillsCli",
        "inputAction": "disable",
        "jsonDefault": true,
        "usage": "skills disable <skill-id> [--json]",
        "examples": ["neon-pilot skills disable code-review --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ]
  },
  "permissions": ["extensions:read", "mcp:write"]
}
