{
  "schemaVersion": 2,
  "id": "system-prompt-assembly",
  "name": "Prompt Assembly",
  "packageType": "system",
  "description": "Internal prompt assembly inspection and controls used by the Extensions surface.",
  "version": "0.1.0",
  "frontend": { "entry": "dist/frontend.js", "styles": [] },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "inspectAgentRuntime",
        "handler": "inspectAgentRuntime",
        "title": "Inspect agent context",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "inspectPromptAssembly",
        "handler": "inspectPromptAssembly",
        "title": "Inspect prompt assembly",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updatePromptAssemblySkillEnabled",
        "handler": "updateSkillEnabled",
        "title": "Enable or disable a skill",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updateRuntimeCapability",
        "handler": "updateRuntimeCapability",
        "title": "Enable or disable an agent capability",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {},
  "permissions": ["extensions:read", "extensions:write", "ui:invalidate"]
}
