{
  "schemaVersion": 2,
  "id": "system-prompt-assembly",
  "name": "Agent Capabilities",
  "packageType": "system",
  "description": "Inspect and manage the capabilities injected into agent runs: extensions, instructions, skills, tools, MCP, templates, and context.",
  "version": "0.1.0",
  "frontend": { "entry": "dist/frontend.js", "styles": [] },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "inspectAgentRuntime", "handler": "inspectAgentRuntime", "title": "Inspect agent runtime" },
      { "id": "inspectPromptAssembly", "handler": "inspectPromptAssembly", "title": "Inspect prompt assembly" },
      { "id": "updatePromptAssemblySkillEnabled", "handler": "updateSkillEnabled", "title": "Enable or disable a skill" },
      { "id": "updateRuntimeCapability", "handler": "updateRuntimeCapability", "title": "Enable or disable a runtime capability" }
    ]
  },
  "contributes": {
    "nav": [
      { "id": "agent-runtime-nav", "label": "Agent Capabilities", "route": "/agent-runtime", "icon": "sparkle", "section": "settings" }
    ],
    "views": [
      {
        "id": "agent-runtime-page",
        "title": "Agent Capabilities",
        "location": "main",
        "route": "/agent-runtime",
        "component": "PromptAssemblyPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      },
      {
        "id": "prompt-assembly-page",
        "title": "Agent Capabilities",
        "location": "main",
        "route": "/prompt-assembly",
        "component": "PromptAssemblyPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ]
  },
  "permissions": ["extensions:read", "extensions:write"]
}
