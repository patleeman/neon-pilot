        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ],
        "smoke": {
          "argv": [
            "background-commands",
            "list"
          ],
          "expectJsonFields": []
