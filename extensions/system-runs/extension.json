{
  "schemaVersion": 2,
  "id": "system-runs",
  "name": "Background Work",
  "packageType": "system",
  "description": "Inspect background commands and subagents linked to the active conversation.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "bash",
        "handler": "bash",
        "title": "Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "background_bash",
        "handler": "background_bash",
        "title": "Background Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "subagent",
        "handler": "subagent",
        "title": "Subagent",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "bash-background",
        "name": "bash",
        "title": "Bash",
        "description": "Execute a bash command. Set background=true to start it as a durable background command.",
        "action": "bash",
        "replaces": "bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "timeout": {
              "type": "number"
            },
            "background": {
              "type": "boolean"
            },
            "taskSlug": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "background-bash",
        "name": "background_bash",
        "title": "Background Bash",
        "description": "Start, inspect, log, rerun, or cancel durable background bash commands.",
        "action": "background_bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "logs",
                "start",
                "rerun",
                "cancel"
              ]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "subagent",
        "name": "subagent",
        "title": "Subagent",
        "description": "Start, inspect, follow up, rerun, or cancel daemon-backed subagent tasks.",
        "action": "subagent",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "logs",
                "start",
                "rerun",
                "follow_up",
                "cancel"
              ]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "loop": {
              "type": "boolean"
            },
            "loopDelay": {
              "type": "string"
            },
            "loopMaxIterations": {
              "type": "number"
            },
            "allowedTools": {
              "description": "Optional comma-separated string or array of actual agent tool names. Common names: bash, read, edit, write, artifact, scheduled_task, conversation, checkpoint, probe_image, web_fetch, web_search, goal, browser_snapshot, browser_cdp, browser_screenshot, conversation, conversation, conversation, conversation, mcp, background_bash, subagent. Shell commands like rg/grep/find/ls are not tool names; allow bash instead.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      }
    ],
    "composerShelves": [
      {
        "id": "activity-shelf",
        "component": "ActivityShelf",
        "title": "Active background work",
        "placement": "bottom"
      }
    ],
    "cliCommands": [
      {
        "id": "background-commands-list",
        "command": "background-commands list",
        "description": "List durable background commands.",
        "action": "background_bash",
        "inputAction": "list",
        "jsonDefault": true,
        "usage": "background-commands list [--json]",
        "examples": [
          "neon-pilot background-commands list",
          "neon-pilot background-commands list --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ],
        "smoke": {
          "argv": [
            "background-commands",
            "list"
          ],
          "expectJsonFields": []
        }
      },
      {
        "id": "background-commands-get",
        "command": "background-commands get",
        "description": "Inspect a background command: background-commands get <run-id>.",
        "action": "background_bash",
        "inputAction": "get",
        "jsonDefault": true,
        "usage": "background-commands get <id> [--json]",
        "examples": [
          "neon-pilot background-commands get example-id",
          "neon-pilot background-commands get example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "background-commands-logs",
        "command": "background-commands logs",
        "description": "Read background command logs: background-commands logs <run-id> [--tail <n>]",
        "action": "background_bash",
        "inputAction": "logs",
        "jsonDefault": true,
        "usage": "background-commands logs <id> [--tail <n>] [--json]",
        "examples": [
          "neon-pilot background-commands logs example-id",
          "neon-pilot background-commands logs example-id --tail 200",
          "neon-pilot background-commands logs example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000,
              "description": "Number of log lines to include."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "background-commands-start",
        "command": "background-commands start",
        "description": "Start a durable background command: background-commands start --command <shell> [--cwd <path>]",
        "action": "background_bash",
        "inputAction": "start",
        "jsonDefault": true,
        "usage": "background-commands start --command <shell> [--cwd <path>] [--json]",
        "examples": [
          "neon-pilot background-commands start --command echo ok",
          "neon-pilot background-commands start --command echo ok --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "description": "Shell command to run in the background."
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "description": "Working directory for the background command."
            },
            "task-slug": {
              "type": "string",
              "minLength": 1,
              "description": "Optional stable label for the run."
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": true
        },
        "mode": "background",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "background-commands-rerun",
        "command": "background-commands rerun",
        "description": "Rerun a background command: background-commands rerun <run-id>.",
        "action": "background_bash",
        "inputAction": "rerun",
        "jsonDefault": true,
        "usage": "background-commands rerun <id> [--json]",
        "examples": [
          "neon-pilot background-commands rerun example-id",
          "neon-pilot background-commands rerun example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "background-commands-cancel",
        "command": "background-commands cancel",
        "description": "Cancel a background command: background-commands cancel <run-id>.",
        "action": "background_bash",
        "inputAction": "cancel",
        "jsonDefault": true,
        "usage": "background-commands cancel <id> [--json]",
        "examples": [
          "neon-pilot background-commands cancel example-id",
          "neon-pilot background-commands cancel example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      }
    ],
    "skills": [
      {
        "id": "runs",
        "title": "Background work",
        "description": "Built-in guidance for detached background commands, subagents, inspection, and follow-up behavior.",
        "path": "skills/runs/SKILL.md"
      }
    ]
  },
  "permissions": [
    "executions:read",
    "executions:start",
    "executions:cancel"
  ]
}
