              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            },
            "task-slug": {
              "type": "string",
              "minLength": 1,
              "description": "Stable slug used to group and identify the durable subagent run."
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "Instruction text for the subagent."
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for the subagent."
            },
            "model": {
              "type": "string",
              "description": "Optional provider/model override, for example opencode-go/deepseek-v4-flash."
            }
          },
          "required": [
            "task-slug",
            "prompt"
