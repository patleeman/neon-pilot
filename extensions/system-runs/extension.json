{
  "schemaVersion": 2,
  "id": "system-runs",
  "name": "Background Work",
  "packageType": "system",
  "description": "Inspect background commands and subagents linked to the active conversation.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "bash",
        "handler": "bash",
        "title": "Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "background_bash",
        "handler": "background_bash",
        "title": "Background Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "subagent",
        "handler": "subagent",
        "title": "Subagent",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "bash-background",
        "name": "bash",
        "title": "Bash",
        "description": "Execute a bash command. Set background=true to start it as a durable background command.",
        "action": "bash",
        "replaces": "bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "timeout": {
              "type": "number"
            },
            "background": {
              "type": "boolean"
            },
            "taskSlug": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      },
      {
        "id": "background-bash",
        "name": "background_bash",
        "title": "Background Bash",
        "description": "Start, inspect, log, rerun, or cancel durable background bash commands.",
        "action": "background_bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "get", "logs", "start", "rerun", "cancel"]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      },
      {
        "id": "subagent",
        "name": "subagent",
        "title": "Subagent",
        "description": "Start, inspect, follow up, rerun, or cancel daemon-backed subagent tasks.",
        "action": "subagent",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "get", "logs", "start", "rerun", "follow_up", "cancel"]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "loop": {
              "type": "boolean"
            },
            "loopDelay": {
              "type": "string"
            },
            "loopMaxIterations": {
              "type": "number"
            },
            "allowedTools": {
              "description": "Optional comma-separated string or array of actual agent tool names. Common names: bash, read, edit, write, artifact, scheduled_task, conversation, checkpoint, probe_image, web_fetch, web_search, goal, browser_snapshot, browser_cdp, browser_screenshot, conversation, conversation, conversation, conversation, mcp, background_bash, subagent. Shell commands like rg/grep/find/ls are not tool names; allow bash instead.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      }
    ],
    "composerShelves": [
      {
        "id": "activity-shelf",
        "component": "ActivityShelf",
        "title": "Active background work",
        "placement": "bottom"
      }
    ],
    "cliCommands": [
      {
        "id": "background-commands-list",
        "command": "background-commands list",
        "description": "List durable background commands.",
        "action": "background_bash",
        "inputAction": "list",
        "jsonDefault": true
      },
      {
        "id": "background-commands-get",
        "command": "background-commands get",
        "description": "Inspect a background command: background-commands get <run-id>.",
        "action": "background_bash",
        "inputAction": "get",
        "jsonDefault": true
      },
      {
        "id": "background-commands-logs",
        "command": "background-commands logs",
        "description": "Read background command logs: background-commands logs <run-id> [--tail <n>]",
        "action": "background_bash",
        "inputAction": "logs",
        "jsonDefault": true
      },
      {
        "id": "background-commands-start",
        "command": "background-commands start",
        "description": "Start a durable background command: background-commands start --command <shell> [--cwd <path>]",
        "action": "background_bash",
        "inputAction": "start",
        "jsonDefault": true
      },
      {
        "id": "background-commands-rerun",
        "command": "background-commands rerun",
        "description": "Rerun a background command: background-commands rerun <run-id>.",
        "action": "background_bash",
        "inputAction": "rerun",
        "jsonDefault": true
      },
      {
        "id": "background-commands-cancel",
        "command": "background-commands cancel",
        "description": "Cancel a background command: background-commands cancel <run-id>.",
        "action": "background_bash",
        "inputAction": "cancel",
        "jsonDefault": true
      },
      {
        "id": "subagents-list",
        "command": "subagents list",
        "description": "List durable subagent runs.",
        "action": "subagent",
        "inputAction": "list",
        "jsonDefault": true
      },
      {
        "id": "subagents-get",
        "command": "subagents get",
        "description": "Inspect a subagent run: subagents get <run-id>.",
        "action": "subagent",
        "inputAction": "get",
        "jsonDefault": true
      },
      {
        "id": "subagents-logs",
        "command": "subagents logs",
        "description": "Read subagent logs: subagents logs <run-id> [--tail <n>]",
        "action": "subagent",
        "inputAction": "logs",
        "jsonDefault": true
      },
      {
        "id": "subagents-start",
        "command": "subagents start",
        "description": "Start a durable subagent: subagents start --prompt <prompt> [--cwd <path>]",
        "action": "subagent",
        "inputAction": "start",
        "jsonDefault": true
      },
      {
        "id": "subagents-rerun",
        "command": "subagents rerun",
        "description": "Rerun a subagent: subagents rerun <run-id>.",
        "action": "subagent",
        "inputAction": "rerun",
        "jsonDefault": true
      },
      {
        "id": "subagents-follow-up",
        "command": "subagents follow-up",
        "description": "Continue a subagent: subagents follow-up <run-id> --prompt <prompt>.",
        "action": "subagent",
        "inputAction": "follow_up",
        "jsonDefault": true
      },
      {
        "id": "subagents-cancel",
        "command": "subagents cancel",
        "description": "Cancel a subagent: subagents cancel <run-id>.",
        "action": "subagent",
        "inputAction": "cancel",
        "jsonDefault": true
      }
    ],
    "skills": [
      {
        "id": "runs",
        "title": "Background work",
        "description": "Built-in guidance for detached background commands, subagents, inspection, and follow-up behavior.",
        "path": "skills/runs/SKILL.md"
      }
    ]
  },
  "permissions": ["runs:read", "runs:write"]
}
