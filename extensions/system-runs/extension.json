{
  "schemaVersion": 2,
  "id": "system-runs",
  "name": "Background Work",
  "packageType": "system",
  "description": "Inspect background commands and subagents linked to the active conversation.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "bash",
        "handler": "bash",
        "title": "Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "background_bash",
        "handler": "background_bash",
        "title": "Background Bash",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "subagent",
        "handler": "subagent",
        "title": "Subagent",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "bash-background",
        "name": "bash",
        "title": "Bash",
        "description": "Execute a bash command. Set background=true to start it as a durable background command.",
        "action": "bash",
        "replaces": "bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "timeout": {
              "type": "number"
            },
            "background": {
              "type": "boolean"
            },
            "taskSlug": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "background-bash",
        "name": "background_bash",
        "title": "Background Bash",
        "description": "Start, inspect, log, rerun, or cancel durable background bash commands.",
        "action": "background_bash",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "logs",
                "start",
                "rerun",
                "cancel"
              ]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "subagent",
        "name": "subagent",
        "title": "Subagent",
        "description": "Start, inspect, follow up, rerun, or cancel daemon-backed subagent tasks.",
        "action": "subagent",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "logs",
                "start",
                "rerun",
                "follow_up",
                "cancel"
              ]
            },
            "runId": {
              "type": "string"
            },
            "taskSlug": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "tail": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "loop": {
              "type": "boolean"
            },
            "loopDelay": {
              "type": "string"
            },
            "loopMaxIterations": {
              "type": "number"
            },
            "allowedTools": {
              "description": "Optional comma-separated string or array of actual agent tool names. Common names: bash, read, edit, write, artifact, scheduled_task, conversation, checkpoint, probe_image, web_fetch, web_search, goal, browser_snapshot, browser_cdp, browser_screenshot, conversation, conversation, conversation, conversation, mcp, background_bash, subagent. Shell commands like rg/grep/find/ls are not tool names; allow bash instead.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      }
    ],
    "composerShelves": [
      {
        "id": "activity-shelf",
        "component": "ActivityShelf",
        "title": "Active background work",
        "placement": "bottom"
      }
    ],
    "cliCommands": [
