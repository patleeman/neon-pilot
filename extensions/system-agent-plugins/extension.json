{
  "schemaVersion": 2,
  "id": "system-agent-plugins",
  "name": "Agent capability packages",
  "packageType": "system",
  "description": "Add trusted external skill packs so agents can use their instructions, tools, and MCP server definitions.",
  "version": "0.1.0",
  "defaultEnabled": true,
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "listPlugins",
        "handler": "listPlugins",
        "title": "List agent plugins",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "addPlugin",
        "handler": "addPlugin",
        "title": "Add agent plugin",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "setPluginEnabled",
        "handler": "setPluginEnabled",
        "title": "Enable or disable agent plugin",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "setPluginAutoUpdate",
        "handler": "setPluginAutoUpdate",
        "title": "Configure agent plugin auto update",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "checkPluginUpdates",
        "handler": "checkPluginUpdates",
        "title": "Check agent plugin updates",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "updatePlugin",
        "handler": "updatePlugin",
        "title": "Update agent plugin",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "removePlugin",
        "handler": "removePlugin",
        "title": "Remove agent plugin",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "settingsComponent": {
      "id": "agent-plugins",
      "component": "AgentPluginsSettingsPanel",
      "sectionId": "settings-agent-plugins",
      "label": "Agent capability packages",
      "description": "Install trusted Codex or Claude-style skill packs. Use this when you want agents to learn reusable workflows, instructions, or MCP server definitions from an external repository.",
      "order": 35
    },
    "commands": [
      {
        "id": "open-agent-plugins",
        "title": "Open agent capability packages",
        "category": "Agent capability packages",
        "description": "Open agent capability package settings.",
        "action": "app.navigate",
        "args": {
          "to": "/settings#agent-plugins"
        },
        "icon": "sparkle"
      },
      {
        "id": "check-agent-plugin-updates",
        "title": "Check capability package updates",
        "category": "Agent capability packages",
        "description": "Check installed agent capability packages for source updates.",
        "action": "checkPluginUpdates"
      }
    ]
  },
  "permissions": ["shell:execute", "filesystem:read", "filesystem:write"]
}
