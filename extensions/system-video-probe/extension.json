{
  "schemaVersion": 2,
  "id": "system-video-probe",
  "name": "Video probe",
  "packageType": "system",
  "description": "Let the agent inspect local video attachments by sampling frames and transcribing audio ranges.",
  "version": "0.1.0",
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "extractVideoFrame",
        "handler": "extractVideoFrameAction",
        "title": "Extract video frame",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "sampleVideoFrames",
        "handler": "sampleVideoFramesAction",
        "title": "Sample video frames",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "transcribeVideo",
        "handler": "transcribeVideoAction",
        "title": "Transcribe video",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "extract-video-frame",
        "name": "extract_video_frame",
        "title": "Extract video frame",
        "description": "Extract one screenshot from a local video attachment at a timestamp. For content questions, use probe_media with videoIds; for manual chaining, pass returned frame imageId values to probe_image.",
        "action": "extractVideoFrame",
        "inputSchema": {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "pattern": "^vid_[a-f0-9]{12}$"
            },
            "timeSec": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["videoId", "timeSec"],
          "additionalProperties": false
        }
      },
      {
        "id": "sample-video-frames",
        "name": "sample_video_frames",
        "title": "Sample video frames",
        "description": "Sample screenshots between two timestamps in a local video attachment. For content questions, use probe_media with videoIds; for manual chaining, pass returned frame imageId values to probe_image.",
        "action": "sampleVideoFrames",
        "inputSchema": {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "pattern": "^vid_[a-f0-9]{12}$"
            },
            "startSec": {
              "type": "number",
              "minimum": 0
            },
            "endSec": {
              "type": "number",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": ["videoId", "startSec", "endSec", "count"],
          "additionalProperties": false
        }
      },
      {
        "id": "transcribe-video",
        "name": "transcribe_video",
        "title": "Transcribe video",
        "description": "Transcribe the audio track from a local video attachment, optionally over a timestamp range.",
        "action": "transcribeVideo",
        "inputSchema": {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "pattern": "^vid_[a-f0-9]{12}$"
            },
            "startSec": {
              "type": "number",
              "minimum": 0
            },
            "endSec": {
              "type": "number",
              "minimum": 0
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": ["videoId"],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": ["videos:read"]
}
