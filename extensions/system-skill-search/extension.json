{
  "schemaVersion": 2,
  "id": "system-skill-search",
  "name": "Skill Search",
  "packageType": "system",
  "description": "Search trusted upstream skill repositories and install vetted skills with approval.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "searchSkills",
        "handler": "searchSkills",
        "title": "Search trusted skills",
        "worker": { "enabled": true, "timeoutMs": 30000 }
      },
      {
        "id": "previewSkill",
        "handler": "previewSkill",
        "title": "Preview trusted skill",
        "worker": { "enabled": true, "timeoutMs": 60000 }
      },
      {
        "id": "installSkill",
        "handler": "installSkill",
        "title": "Install trusted skill",
        "worker": { "enabled": true, "timeoutMs": 60000 }
      },
      {
        "id": "listState",
        "handler": "listState",
        "title": "List skill search state",
        "worker": { "enabled": true }
      },
      {
        "id": "listInstalledSkillContributions",
        "handler": "listInstalledSkillContributions",
        "title": "List installed upstream skills",
        "worker": { "enabled": true }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "skill-search",
        "name": "skill_search",
        "title": "Search Skills",
        "description": "Search trusted upstream skill repositories for a reusable skill before hand-writing a workflow.",
        "action": "searchSkills",
        "promptGuidelines": [
          "Use this before inventing a new recurring workflow skill; search results are metadata only and are safe to inspect."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Skill topic, workflow, product, or capability to search for." },
            "limit": { "type": "number", "description": "Maximum results, capped at 20." }
          },
          "required": ["query"],
          "additionalProperties": false
        }
      },
      {
        "id": "skill-preview",
        "name": "skill_preview",
        "title": "Preview Skill",
        "description": "Fetch and vet one trusted skill candidate before asking the user to approve installation.",
        "action": "previewSkill",
        "promptGuidelines": ["Preview does not install. Read the risk summary and ask the user before calling skill_install."],
        "inputSchema": {
          "type": "object",
          "properties": {
            "candidateId": { "type": "string", "description": "Candidate id returned by skill_search." }
          },
          "required": ["candidateId"],
          "additionalProperties": false
        }
      },
      {
        "id": "skill-install",
        "name": "skill_install",
        "title": "Install Skill",
        "description": "Install a vetted upstream skill after explicit user approval.",
        "action": "installSkill",
        "promptGuidelines": ["Only call with approved=true after the user explicitly approves the exact candidate and risk summary."],
        "inputSchema": {
          "type": "object",
          "properties": {
            "candidateId": { "type": "string", "description": "Candidate id returned by skill_search." },
            "approved": { "type": "boolean", "description": "Must be true only after explicit user approval." }
          },
          "required": ["candidateId", "approved"],
          "additionalProperties": false
        }
      }
    ],
    "skillProviders": [
      {
        "id": "installed-upstream-skills",
        "handler": "listInstalledSkillContributions",
        "title": "Installed Upstream Skills",
        "priority": 20
      }
    ],
    "settingsComponent": {
      "id": "skill-search-settings",
      "component": "SkillSearchSettingsPanel",
      "sectionId": "settings-skill-search",
      "label": "Skill Search",
      "description": "Trusted upstream skill search, vetting, and installed skill provenance.",
      "order": 47
    },
    "commands": [
      {
        "id": "open-skill-search-settings",
        "title": "Open Skill Search Settings",
        "category": "Settings",
        "description": "Open trusted upstream skill search settings.",
        "action": "app.navigate",
        "args": { "to": "/settings#settings-skill-search" },
        "icon": "sparkle"
      }
    ]
  },
  "permissions": ["network:read", "storage:readwrite", "filesystem:readwrite", "agent:run", "ui:invalidate", "mcp:write"]
}
