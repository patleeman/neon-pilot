{
  "schemaVersion": 2,
  "id": "system-skill-search",
  "name": "Skill Search",
  "packageType": "system",
  "description": "Search upstream skill repositories and install vetted skills with trusted-source provenance and community approval.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      {
        "id": "searchSkills",
        "handler": "searchSkills",
        "title": "Search upstream skills",
        "worker": { "enabled": true, "timeoutMs": 90000 }
      },
      {
        "id": "previewSkill",
        "handler": "previewSkill",
        "title": "Preview upstream skill",
        "worker": { "enabled": true, "timeoutMs": 60000 }
      },
      {
        "id": "installSkill",
        "handler": "installSkill",
        "title": "Install upstream skill",
        "worker": { "enabled": true, "timeoutMs": 120000 }
      },
      {
        "id": "listState",
        "handler": "listState",
        "title": "List skill search state",
        "worker": { "enabled": true }
      },
      {
        "id": "listInstalledSkillContributions",
        "handler": "listInstalledSkillContributions",
        "title": "List installed upstream skills",
        "worker": { "enabled": true }
      },
      {
        "id": "skillSearchCli",
        "handler": "skillSearchCli",
        "title": "Skill Search CLI",
        "worker": { "enabled": true, "inputActions": ["search", "preview", "install", "state", "installed"], "timeoutMs": 120000 }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "skill-search",
        "name": "skill_search",
        "title": "Search Skills",
        "description": "Search upstream skill repositories with an isolated no-tools discovery reviewer and return a ranked shortlist for the agent to choose from.",
        "action": "searchSkills",
        "promptGuidelines": [
          "Call with the capability intent and relevant task context before inventing a recurring workflow skill.",
          "The tool performs upstream search, host-controlled preview fetching, and isolated no-tools discovery review; it returns a ranked shortlist, not a user decision.",
          "Read the shortlist, choose the best candidate yourself, and call skill_install with that candidateId. Do not ask the user to pick from the list."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "intent": { "type": "string", "description": "Capability, workflow, or product context the agent needs a skill for." },
            "context": { "type": "string", "description": "Optional task context that helps the isolated discovery reviewer judge fit." },
            "limit": { "type": "number", "description": "Maximum results, capped at 20." }
          },
          "required": ["intent"],
          "additionalProperties": false
        }
      },
      {
        "id": "skill-preview",
        "name": "skill_preview",
        "title": "Preview Skill",
        "description": "Fetch and vet one skill candidate for body and risk inspection without installing it.",
        "action": "previewSkill",
        "promptGuidelines": ["Preview does not install. Use skill_install to perform the enforced vetting, approval, and install path."],
        "inputSchema": {
          "type": "object",
          "properties": {
            "candidateId": { "type": "string", "description": "Candidate id returned by skill_search." }
          },
          "required": ["candidateId"],
          "additionalProperties": false
        }
      },
      {
        "id": "skill-install",
        "name": "skill_install",
        "title": "Install Skill",
        "description": "Fetch, vet, and install the selected upstream skill. Trusted sources install directly; community sources trigger host approval.",
        "action": "installSkill",
        "promptGuidelines": [
          "Call only after you have selected the best candidate from skill_search results.",
          "Do not ask the user to choose a skill or to approve in chat. Community approvals are handled by the host approval shelf."
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "candidateId": {
              "type": "string",
              "description": "Candidate id returned by skill_search after the agent selected the best fit."
            }
          },
          "required": ["candidateId"],
          "additionalProperties": false
        }
      }
    ],
    "skillProviders": [
      {
        "id": "installed-upstream-skills",
        "handler": "listInstalledSkillContributions",
        "title": "Installed Upstream Skills",
        "priority": 20
      }
    ],
    "settingsComponent": {
      "id": "skill-search-settings",
      "component": "SkillSearchSettingsPanel",
      "sectionId": "settings-skill-search",
      "label": "Skill Search",
      "description": "Upstream skill search, vetting, and installed skill provenance.",
      "order": 47
    },
    "commands": [
      {
        "id": "open-skill-search-settings",
        "title": "Open Skill Search Settings",
        "category": "Settings",
        "description": "Open upstream skill search settings.",
        "action": "app.navigate",
        "args": { "to": "/settings#settings-skill-search" },
        "icon": "sparkle"
      }
    ],
    "cliCommands": [
      {
        "id": "skills-search-upstream",
        "command": "skills search",
        "description": "Search upstream skill repositories.",
        "action": "skillSearchCli",
        "inputAction": "search",
        "jsonDefault": true,
        "usage": "skills search <intent> [--context <text>] [--limit <n>] [--json]",
        "examples": ["neon-pilot skills search \"code review\" --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "context": { "type": "string", "description": "Task context for ranking." },
            "limit": { "type": "string", "description": "Maximum search results." }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "skills-preview-upstream",
        "command": "skills preview",
        "description": "Preview and vet an upstream skill candidate.",
        "action": "skillSearchCli",
        "inputAction": "preview",
        "jsonDefault": true,
        "usage": "skills preview <candidate-id> [--json]",
        "examples": ["neon-pilot skills preview candidate-id --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "skills-install-upstream",
        "command": "skills install",
        "description": "Install a vetted upstream skill candidate.",
        "action": "skillSearchCli",
        "inputAction": "install",
        "jsonDefault": true,
        "usage": "skills install <candidate-id> [--json]",
        "examples": ["neon-pilot skills install candidate-id --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 1 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean", "description": "Print structured JSON output." },
            "dry-run": { "type": "boolean", "description": "Validate and describe the operation without changing app state." }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "skills-installed-upstream",
        "command": "skills installed",
        "description": "List installed upstream skill contributions.",
        "action": "skillSearchCli",
        "inputAction": "installed",
        "jsonDefault": true,
        "usage": "skills installed [--json]",
        "examples": ["neon-pilot skills installed --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      },
      {
        "id": "skills-search-state",
        "command": "skills search-state",
        "description": "List Skill Search candidates, previews, and installed records.",
        "action": "skillSearchCli",
        "inputAction": "state",
        "jsonDefault": true,
        "usage": "skills search-state [--json]",
        "examples": ["neon-pilot skills search-state --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean", "description": "Print structured JSON output." } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"]
      }
    ]
  },
  "permissions": ["network:read", "storage:readwrite", "filesystem:readwrite", "agent:run", "ui:confirm", "ui:invalidate", "mcp:write"]
}
