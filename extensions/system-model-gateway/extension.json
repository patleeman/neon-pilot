{
  "schemaVersion": 2,
  "id": "system-model-gateway",
  "name": "AI Gateway",
  "packageType": "system",
  "description": "Local Responses API proxy for external coding agents, backed by Neon Pilot model providers.",
  "version": "0.1.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": ["dist/frontend.css"]
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "services": [
      {
        "id": "loopback",
        "handler": "startGatewayService",
        "stopHandler": "stopGatewayService",
        "healthCheck": "gatewayServiceHealth",
        "title": "AI Gateway loopback server",
        "restart": "on-failure",
        "worker": { "enabled": true }
      }
    ],
    "actions": [
      { "id": "status", "handler": "status", "title": "AI Gateway status", "worker": { "enabled": true } },
      { "id": "updateSettings", "handler": "updateSettings", "title": "Update AI Gateway settings", "worker": { "enabled": true } },
      { "id": "clearLogs", "handler": "clearLogs", "title": "Clear AI Gateway logs", "worker": { "enabled": true } },
      {
        "id": "gatewayCli",
        "handler": "gatewayCli",
        "title": "AI Gateway CLI",
        "worker": { "enabled": true, "inputActions": ["status", "settings-set", "clear-logs"] }
      }
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/health",
        "handler": "healthRoute",
        "title": "AI Gateway health",
        "worker": { "enabled": true }
      },
      {
        "method": "GET",
        "path": "/v1/models",
        "handler": "modelsRoute",
        "title": "Responses API models",
        "worker": { "enabled": true }
      },
      {
        "method": "POST",
        "path": "/v1/responses",
        "handler": "responsesRoute",
        "title": "Responses API response",
        "stream": "sse",
        "worker": { "enabled": true }
      },
      {
        "method": "POST",
        "path": "/v1/responses/stream",
        "handler": "responsesStreamRoute",
        "title": "Responses API response stream",
        "stream": "sse",
        "worker": { "enabled": true }
      }
    ]
  },
  "contributes": {
    "settingsComponent": {
      "id": "model-gateway-settings",
      "component": "ModelGatewaySettingsPanel",
      "sectionId": "settings-model-gateway",
      "label": "AI Gateway",
      "description": "Local OpenAI Responses-compatible endpoint for external coding agents.",
      "order": 45
    },
    "commands": [
      {
        "id": "open-model-gateway-settings",
        "title": "Open AI Gateway Settings",
        "category": "Settings",
        "description": "Open the AI Gateway setup panel.",
        "action": "app.navigate",
        "args": {
          "to": "/settings#settings-model-gateway"
        },
        "icon": "graph"
      }
    ],
    "cliCommands": [
      {
        "id": "ai-gateway-status",
        "command": "ai-gateway status",
        "description": "Read AI Gateway status.",
        "action": "gatewayCli",
        "inputAction": "status",
        "jsonDefault": true,
        "usage": "ai-gateway status [--json]",
        "examples": ["neon-pilot ai-gateway status --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean" } },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": ["text", "json"],
        "smoke": { "argv": ["ai-gateway", "status"], "expectJsonFields": [] }
      },
      {
        "id": "ai-gateway-settings-set",
        "command": "ai-gateway settings set",
        "description": "Update AI Gateway settings.",
        "action": "gatewayCli",
        "inputAction": "settings-set",
        "jsonDefault": true,
        "usage": "ai-gateway settings set [--enabled] [--host <host>] [--port <port>] [--default-model <model>] [--auth-token <token>] [--json]",
        "examples": ["neon-pilot ai-gateway settings set --port 8788 --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "number" },
            "default-model": { "type": "string" },
            "auth-token": { "type": "string" },
            "json": { "type": "boolean" },
            "dry-run": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      },
      {
        "id": "ai-gateway-clear-logs",
        "command": "ai-gateway logs clear",
        "description": "Clear AI Gateway logs.",
        "action": "gatewayCli",
        "inputAction": "clear-logs",
        "jsonDefault": true,
        "usage": "ai-gateway logs clear [--json]",
        "examples": ["neon-pilot ai-gateway logs clear --json"],
        "argsSchema": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "flagsSchema": {
          "type": "object",
          "properties": { "json": { "type": "boolean" }, "dry-run": { "type": "boolean" } },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": true,
        "destructive": true,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": ["text", "json"]
      }
    ]
  },
  "permissions": ["storage:readwrite", "network:listen"]
}
