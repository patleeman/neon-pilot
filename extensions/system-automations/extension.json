{
  "schemaVersion": 2,
  "id": "system-automations",
  "name": "Automations",
  "packageType": "system",
  "description": "Manage scheduled and conversation-bound automations.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "scheduledTask",
        "handler": "scheduledTask",
        "title": "Scheduled task",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deferredResume",
        "handler": "deferredResume",
        "title": "Deferred resume",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "eventBus",
        "handler": "eventBus",
        "title": "Event bus",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "new",
        "title": "New Automation",
        "category": "Automations",
        "description": "Open the automation creation flow.",
        "action": "app.navigate",
        "args": {
          "to": "/automations?action=new"
        },
        "icon": "automation"
      }
    ],
    "tools": [
      {
        "id": "scheduled-task",
        "name": "scheduled_task",
        "title": "Scheduled task",
        "description": "Create, inspect, validate, run, and delete daemon-managed scheduled tasks.",
        "action": "scheduledTask",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "get", "save", "delete", "validate", "run"]
            },
            "profile": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "cron": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "targetType": {
              "type": "string",
              "enum": ["background-agent", "conversation"]
            },
            "threadMode": {
              "type": "string",
              "enum": ["dedicated", "existing", "none"]
            },
            "threadConversationId": {
              "type": "string"
            },
            "deliverAs": {
              "type": "string",
              "enum": ["steer", "followUp"]
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 1
            },
            "catchUpWindowSeconds": {
              "type": "number",
              "minimum": 1
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "prompt": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "notifyOnSuccess": {
              "type": "boolean"
            },
            "notifyOnFailure": {
              "type": "boolean"
            },
            "requireAck": {
              "type": "boolean"
            },
            "autoResumeIfOpen": {
              "type": "boolean"
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      },
      {
        "id": "event-bus",
        "name": "event_bus",
        "title": "Event bus",
        "description": "Emit inspectable events, replay events, and manage event subscriptions that can start agents, scripts, threads, tasks, or publish follow-on events.",
        "action": "eventBus",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["emit", "replay", "list", "list_subscriptions", "save_subscription", "delete_subscription"]
            },
            "type": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            },
            "eventId": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "subscriptionId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "subscriptionAction": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": ["action"],
          "additionalProperties": true
        }
      }
    ],
    "nav": [
      {
        "id": "nav",
        "label": "Automations",
        "route": "/automations",
        "icon": "automation"
      }
    ],
    "views": [
