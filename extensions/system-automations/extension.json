{
  "schemaVersion": 2,
  "id": "system-automations",
  "name": "Automations",
  "packageType": "system",
  "description": "Manage scheduled and conversation-bound automations.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "scheduledTask",
        "handler": "scheduledTask",
        "title": "Scheduled task",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deferredResume",
        "handler": "deferredResume",
        "title": "Deferred resume",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "new",
        "title": "New Automation",
        "category": "Automations",
        "description": "Open the automation creation flow.",
        "action": "app.navigate",
        "args": {
          "to": "/automations?action=new"
        },
        "icon": "automation"
      }
    ],
    "tools": [
      {
        "id": "scheduled-task",
        "name": "scheduled_task",
        "title": "Scheduled task",
        "description": "Create, inspect, validate, run, and delete daemon-managed scheduled tasks.",
        "action": "scheduledTask",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "get",
                "save",
                "delete",
                "validate",
                "run"
              ]
            },
            "profile": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "cron": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "targetType": {
              "type": "string",
              "enum": [
                "background-agent",
                "conversation"
              ]
            },
            "threadMode": {
              "type": "string",
              "enum": [
                "dedicated",
                "existing",
                "none"
              ]
            },
            "threadConversationId": {
              "type": "string"
            },
            "deliverAs": {
              "type": "string",
              "enum": [
                "steer",
                "followUp"
              ]
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 1
            },
            "catchUpWindowSeconds": {
              "type": "number",
              "minimum": 1
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "prompt": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "notifyOnSuccess": {
              "type": "boolean"
            },
            "notifyOnFailure": {
              "type": "boolean"
            },
            "requireAck": {
              "type": "boolean"
            },
            "autoResumeIfOpen": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      }
    ],
    "nav": [
      {
        "id": "nav",
        "label": "Automations",
        "route": "/automations",
        "icon": "automation"
      }
    ],
    "views": [
      {
        "id": "page",
        "title": "Automations",
        "location": "main",
        "route": "/automations",
        "component": "AutomationsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "cliCommands": [
      {
        "id": "tasks-list",
        "command": "tasks list",
        "description": "List scheduled tasks.",
        "action": "scheduledTask",
        "inputAction": "list",
        "jsonDefault": true,
        "usage": "tasks list [--json]",
        "examples": [
          "neon-pilot tasks list",
          "neon-pilot tasks list --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 0
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ],
        "smoke": {
          "argv": [
            "tasks",
            "list"
          ],
          "expectJsonFields": []
        }
      },
      {
        "id": "tasks-get",
        "command": "tasks get",
        "description": "Inspect a scheduled task: tasks get <task-id>.",
        "action": "scheduledTask",
        "inputAction": "get",
        "jsonDefault": true,
        "usage": "tasks get <id> [--json]",
        "examples": [
          "neon-pilot tasks get example-id",
          "neon-pilot tasks get example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "tasks-save",
        "command": "tasks save",
        "description": "Create or update a scheduled task: tasks save <task-id> --title <title> --prompt <prompt> [--cron <expr>|--at <iso>]",
        "action": "scheduledTask",
        "inputAction": "save",
        "jsonDefault": true,
        "usage": "tasks save <id> [--json]",
        "examples": [
          "neon-pilot tasks save daily-check --prompt \"Check status\" --cron \"0 9 * * *\"",
          "neon-pilot tasks save daily-check --prompt \"Check status\" --cron \"0 9 * * *\" --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "write",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "tasks-delete",
        "command": "tasks delete",
        "description": "Delete a scheduled task: tasks delete <task-id>.",
        "action": "scheduledTask",
        "inputAction": "delete",
        "jsonDefault": true,
        "usage": "tasks delete <id> [--json]",
        "examples": [
          "neon-pilot tasks delete example-id",
          "neon-pilot tasks delete example-id --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "destructive",
        "requiresApp": false,
        "destructive": true,
        "idempotent": false,
        "startsBackgroundWork": false,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      },
      {
        "id": "tasks-validate",
        "command": "tasks validate",
        "description": "Validate scheduled tasks, or one scheduled task by id.",
        "action": "scheduledTask",
        "inputAction": "validate",
        "jsonDefault": true,
        "usage": "tasks validate [id] [--json]",
        "examples": [
          "neon-pilot tasks validate",
          "neon-pilot tasks validate daily-check",
          "neon-pilot tasks validate --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "description": "Optional positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            }
          },
          "additionalProperties": true
        },
        "mode": "read",
        "requiresApp": false,
        "destructive": false,
        "idempotent": true,
        "startsBackgroundWork": false,
        "supportsDryRun": false,
        "outputModes": [
          "text",
          "json"
        ],
        "smoke": {
          "argv": [
            "tasks",
            "validate"
          ],
          "expectJsonFields": []
        }
      },
      {
        "id": "tasks-run",
        "command": "tasks run",
        "description": "Run a scheduled task immediately: tasks run <task-id>.",
        "action": "scheduledTask",
        "inputAction": "run",
        "jsonDefault": true,
        "usage": "tasks run <id> [--json]",
        "examples": [
          "neon-pilot tasks run daily-check",
          "neon-pilot tasks run daily-check --json"
        ],
        "argsSchema": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Positional args: id."
        },
        "flagsSchema": {
          "type": "object",
          "properties": {
            "json": {
              "type": "boolean",
              "description": "Print structured JSON output."
            },
            "dry-run": {
              "type": "boolean",
              "description": "Validate and describe the operation without changing runtime state."
            }
          },
          "additionalProperties": true
        },
        "mode": "background",
        "requiresApp": false,
        "destructive": false,
        "idempotent": false,
        "startsBackgroundWork": true,
        "supportsDryRun": true,
        "outputModes": [
          "text",
          "json"
        ]
      }
    ],
    "skills": [
      {
        "id": "async-attention",
        "title": "Async Attention and Wakeups",
        "description": "Built-in routing guide for follow-up queues, owning surfaces, and later attention.",
        "path": "skills/async-attention/SKILL.md"
      },
      {
        "id": "scheduled-tasks",
        "title": "Scheduled Tasks",
        "description": "Built-in guidance for daemon-backed scheduled automations and conversation callbacks.",
        "path": "skills/scheduled-tasks/SKILL.md"
      }
    ]
  },
  "permissions": [
    "automations:read",
    "automations:write",
    "automations:run",
    "executions:read",
    "executions:start",
    "conversations:readwrite",
    "telemetry:write",
    "ui:notify"
  ]
}
