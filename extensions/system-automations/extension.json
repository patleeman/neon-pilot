{
  "schemaVersion": 2,
  "id": "system-automations",
  "name": "Automations",
  "packageType": "system",
  "description": "Manage scheduled and conversation-bound automations.",
  "version": "0.2.0",
  "frontend": {
    "entry": "dist/frontend.js",
    "styles": []
  },
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "scheduledTask",
        "handler": "scheduledTask",
        "title": "Scheduled task",
        "worker": {
          "enabled": true
        }
      },
      {
        "id": "deferredResume",
        "handler": "deferredResume",
        "title": "Deferred resume",
        "worker": {
          "enabled": true
        }
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "scheduled-task",
        "name": "scheduled_task",
        "title": "Scheduled task",
        "description": "Create, inspect, validate, run, and delete daemon-managed scheduled tasks.",
        "action": "scheduledTask",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["list", "get", "save", "delete", "validate", "run"]
            },
            "profile": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            },
            "cron": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "targetType": {
              "type": "string",
              "enum": ["background-agent", "conversation"]
            },
            "threadMode": {
              "type": "string",
              "enum": ["dedicated", "existing", "none"]
            },
            "threadConversationId": {
              "type": "string"
            },
            "deliverAs": {
              "type": "string",
              "enum": ["steer", "followUp"]
            },
            "model": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 1
            },
            "catchUpWindowSeconds": {
              "type": "number",
              "minimum": 1
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "prompt": {
              "type": "string"
            },
            "deliverResultToConversation": {
              "type": "boolean"
            },
            "notifyOnSuccess": {
              "type": "boolean"
            },
            "notifyOnFailure": {
              "type": "boolean"
            },
            "requireAck": {
              "type": "boolean"
            },
            "autoResumeIfOpen": {
              "type": "boolean"
            }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      }
    ],
    "nav": [
      {
        "id": "nav",
        "label": "Automations",
        "route": "/automations",
        "icon": "automation"
      }
    ],
    "views": [
      {
        "id": "page",
        "title": "Automations",
        "location": "main",
        "route": "/automations",
        "component": "AutomationsPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "cliCommands": [
      {
        "id": "tasks-list",
        "command": "tasks list",
        "description": "List scheduled tasks.",
        "action": "scheduledTask",
        "inputAction": "list",
        "jsonDefault": true
      },
      {
        "id": "tasks-get",
        "command": "tasks get",
        "description": "Inspect a scheduled task: tasks get <task-id>.",
        "action": "scheduledTask",
        "inputAction": "get",
        "jsonDefault": true
      },
      {
        "id": "tasks-save",
        "command": "tasks save",
        "description": "Create or update a scheduled task: tasks save [task-id] --title <title> --prompt <prompt> [--cron <expr>|--at <iso>]",
        "action": "scheduledTask",
        "inputAction": "save",
        "jsonDefault": true
      },
      {
        "id": "tasks-delete",
        "command": "tasks delete",
        "description": "Delete a scheduled task: tasks delete <task-id>.",
        "action": "scheduledTask",
        "inputAction": "delete",
        "jsonDefault": true
      },
      {
        "id": "tasks-validate",
        "command": "tasks validate",
        "description": "Validate a scheduled task payload: tasks validate [task-id] ...",
        "action": "scheduledTask",
        "inputAction": "validate",
        "jsonDefault": true
      },
      {
        "id": "tasks-run",
        "command": "tasks run",
        "description": "Run a scheduled task immediately: tasks run <task-id>.",
        "action": "scheduledTask",
        "inputAction": "run",
        "jsonDefault": true
      }
    ],
    "skills": [
      {
        "id": "async-attention",
        "title": "Async Attention and Wakeups",
        "description": "Built-in routing guide for follow-up queues, owning surfaces, and later attention.",
        "path": "skills/async-attention/SKILL.md"
      },
      {
        "id": "scheduled-tasks",
        "title": "Scheduled Tasks",
        "description": "Built-in guidance for daemon-backed scheduled automations and conversation callbacks.",
        "path": "skills/scheduled-tasks/SKILL.md"
      }
    ]
  },
  "permissions": ["runs:read", "runs:start", "conversations:readwrite", "ui:notify"]
}
