{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@neon-pilot/core": ["./packages/core/src"],
      "@neon-pilot/daemon": ["./packages/desktop/server/daemon"],
      "@neon-pilot/extensions": ["./packages/extensions/src"],
      "@neon-pilot/extensions/host": ["./packages/desktop/ui/src/extensions/host"],
      "@neon-pilot/extensions/ui": ["./packages/desktop/ui/src/extensions/ui"],
      "@neon-pilot/extensions/workbench": ["./packages/desktop/ui/src/extensions/workbench"],
      "@neon-pilot/extensions/data": ["./packages/desktop/ui/src/extensions/data"],
      "@neon-pilot/extensions/settings": ["./packages/desktop/ui/src/extensions/settings"],
      "@neon-pilot/extensions/excalidraw": ["./packages/extensions/src/excalidraw"],
      "@neon-pilot/extensions/backend": ["./packages/desktop/server/extensions/backendApi"],
      "@neon-pilot/extensions/backend/*": ["./packages/desktop/server/extensions/backendApi/*"]
    }
  },
  "references": [{ "path": "./packages/core" }, { "path": "./packages/extensions" }, { "path": "./packages/desktop" }],
  "files": [],
  "exclude": ["node_modules", "dist"]
}
