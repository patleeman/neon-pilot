{
  "schemaVersion": 2,
  "id": "system-template-crud-page",
  "name": "Template: CRUD Page",
  "description": "Starter template — management page with a list view and slide-in editor form. Full create/edit/delete.",
  "version": "0.1.0",
  "defaultEnabled": false,
  "frontend": {
    "entry": "dist/frontend.js"
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "templateItemsList", "handler": "list", "title": "List items" },
      { "id": "templateItemsGet", "handler": "get", "title": "Get item" },
      { "id": "templateItemsSave", "handler": "save", "title": "Save item" },
      { "id": "templateItemsDelete", "handler": "delete", "title": "Delete item" }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "Template: CRUD Page",
        "location": "main",
        "route": "/ext/template-crud-page",
        "component": "CrudPage",
        "placement": "primary",
        "scope": "global",
        "activation": "on-route"
      }
    ],
    "nav": [
      {
        "id": "nav",
        "label": "CRUD Page",
        "route": "/ext/template-crud-page",
        "icon": "kanban"
      }
    ]
  },
  "permissions": []
}
