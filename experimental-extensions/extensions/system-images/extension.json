{
  "schemaVersion": 2,
  "id": "system-images",
  "name": "Images",
  "packageType": "system",
  "defaultEnabled": false,
  "description": "Generate and edit images from agent conversations.",
  "version": "0.1.0",
  "backend": {
    "entry": "src/backend.ts",
    "actions": [
      {
        "id": "image",
        "handler": "image",
        "title": "Image"
      }
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "image",
        "name": "image",
        "title": "Generate image",
        "description": "Generate or edit a single image from a prompt, optionally using recent conversation images as references.",
        "action": "image",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "quality": {
              "type": "string",
              "enum": ["auto", "low", "medium", "high"]
            },
            "background": {
              "type": "string",
              "enum": ["auto", "opaque", "transparent"]
            },
            "action": {
              "type": "string",
              "enum": ["auto", "generate", "edit"]
            },
            "source": {
              "type": "string",
              "enum": ["none", "latest", "latest-user", "latest-generated", "recent"]
            },
            "sourceCount": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": ["prompt"],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": ["images:read", "images:write"]
}
