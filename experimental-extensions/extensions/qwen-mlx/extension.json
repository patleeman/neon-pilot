{
  "schemaVersion": 2,
  "id": "qwen-mlx",
  "name": "MLX Local Models Runtime",
  "description": "Backend runtime implementation for Local Models MLX support.",
  "version": "0.2.0",
  "packageType": "user",
  "defaultEnabled": false,
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "mlxStatus", "handler": "status", "title": "MLX status" },
      { "id": "mlxSetModel", "handler": "setModel", "title": "Set MLX model" },
      { "id": "mlxSetup", "handler": "setup", "title": "Set up MLX model" },
      { "id": "mlxStart", "handler": "start", "title": "Start MLX runtime" },
      { "id": "mlxStop", "handler": "stop", "title": "Stop MLX runtime" },
      { "id": "mlxDeleteModel", "handler": "deleteModel", "title": "Delete MLX model" },
      { "id": "mlxSearchModels", "handler": "searchModels", "title": "Search Hugging Face MLX models" }
    ]
  },
  "contributes": {
    "views": [],
    "nav": [],
    "tools": []
  },
  "permissions": ["network:listen"]
}
