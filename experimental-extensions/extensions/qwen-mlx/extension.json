{
  "schemaVersion": 2,
  "id": "qwen-mlx",
  "name": "MLX Local Models",
  "description": "Set up, start, stop, and register local Hugging Face MLX models.",
  "version": "0.2.0",
  "packageType": "user",
  "defaultEnabled": false,
  "frontend": {
    "entry": "dist/frontend.js"
  },
  "backend": {
    "entry": "dist/backend.mjs",
    "actions": [
      { "id": "mlxStatus", "handler": "status", "title": "MLX status" },
      { "id": "mlxSetModel", "handler": "setModel", "title": "Set MLX model" },
      { "id": "mlxSetup", "handler": "setup", "title": "Set up MLX model" },
      { "id": "mlxStart", "handler": "start", "title": "Start MLX runtime" },
      { "id": "mlxStop", "handler": "stop", "title": "Stop MLX runtime" },
      { "id": "mlxSearchModels", "handler": "searchModels", "title": "Search Hugging Face MLX models" }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "page",
        "title": "MLX Local Models",
        "location": "main",
        "route": "/ext/qwen-mlx",
        "component": "QwenMlxPage"
      }
    ],
    "nav": [],
    "tools": [
      {
        "id": "mlx_local_status",
        "name": "mlx_local_status",
        "description": "Check which local MLX model is selected, loaded, installed, and running.",
        "action": "mlxStatus",
        "inputSchema": { "type": "object", "properties": {} }
      }
    ]
  },
  "permissions": ["network:listen"]
}
