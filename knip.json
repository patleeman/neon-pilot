{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "autoprefixer",
    "postcss",
    "esbuild",
    "@electron/asar",
    "electron",
    "tsx",
    "undici-types",
    "qrcode",
    "whisper-cpp-node",
    "@agentclientprotocol/sdk",
    "@neon-pilot/ui",
    "@neon-pilot/extensions",
    "@sinclair/typebox",
    "@vitejs/plugin-react",
    "mermaid",
    "@tiptap/core",
    "@tiptap/extension-image",
    "@tiptap/extension-link",
    "@tiptap/extension-placeholder",
    "@tiptap/extension-task-item",
    "@tiptap/extension-task-list",
    "@tiptap/markdown",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "yjs"
  ],
  "ignoreIssues": {
    "packages/desktop/ui/src/components/chat/ArtifactCheckpointToolBlocks.tsx": ["exports"],
    "packages/desktop/ui/src/components/chat/AskUserQuestionToolBlock.tsx": ["exports"],
    "packages/desktop/ui/src/components/chat/DiffActionButton.tsx": ["exports"],
    "packages/desktop/ui/src/components/ConversationCheckpointWorkbench.tsx": ["exports"],
    "packages/desktop/ui/src/components/ui.tsx": ["exports", "types"],
    "packages/desktop/ui/src/extensions/data.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/commands.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/ExtensionChatRail.tsx": ["types"],
    "packages/desktop/ui/src/extensions/extensionRouteStream.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/extensionRegistryEvents.ts": ["exports"],
    "packages/desktop/ui/src/extensions/host.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/extensions/hostViewComponents.tsx": ["exports", "types"],
    "packages/desktop/ui/src/extensions/selection.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/settings.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/types.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/ui.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/useExtensionRegistry.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-artifacts.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-browser.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-diffs.ts": ["exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-files.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-runs.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/extensions/workbench-transcript.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/extensions/workbench.ts": ["files", "exports", "types"],
    "packages/desktop/ui/src/components/workbench/WorkbenchBrowserTab.tsx": ["exports"],
    "packages/desktop/ui/src/components/workspace/WorkspaceExplorer.tsx": ["exports"],
    "packages/desktop/ui/src/client/api.ts": ["types"],
    "packages/desktop/ui/src/components/ScheduledTaskPanel.tsx": ["exports"],
    "packages/desktop/ui/src/components/shared/TextPromptDialog.tsx": ["types"],
    "packages/desktop/ui/src/conversation/useConversationComposerMenus.ts": ["types"],
    "packages/desktop/ui/src/gateways/gatewayEvents.ts": ["exports"],
    "packages/desktop/ui/src/local/workbenchBrowserTabs.ts": ["exports"],
    "packages/desktop/ui/src/pages/SettingsPage.tsx": ["unresolved"],
    "packages/desktop/ui/src/shared/types.ts": ["types"],
    "packages/desktop/ui/src/store/index.ts": ["exports", "types"],
    "packages/desktop/ui/src/ui-state/theme.ts": ["types"],
    "packages/core/src/runtime/paths.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "*.config.mjs"],
      "project": ["scripts/*.mjs", "*.config.mjs"]
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/desktop": {
      "entry": [
        "src/preload.cts",
        "src/main.ts",
        "src/companion/runtime.ts",
        "src/backend/extension-host-child.ts",
        "src/backend/local-backend-child.ts",
        "src/**/*.test.ts",
        "ui/src/app/main.tsx",
        "ui/src/app/globals.d.ts",
        "ui/src/app/vite-env.d.ts",
        "ui/src/**/*.test.ts",
        "ui/src/**/*.test.tsx",
        "ui/vite.config.ts",
        "ui/postcss.config.js",
        "ui/tailwind.config.js",
        "server/**/*.test.ts",
        "../../extensions/**/src/backend.ts",
        "../../extensions/**/src/frontend.tsx",
        "../../extensions/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,cts}", "ui/src/**/*.{ts,tsx}", "server/**/*.ts", "../../extensions/**/*.ts", "../../extensions/**/*.tsx"]
    }
  },
  "ignore": ["packages/desktop/server/**/*.ts", "extensions/**/*.ts", "extensions/**/*.tsx"]
}
